# dev.env.example
# ------------------------------------------------------------------------
# Local credentials and settings for run_sampling.py.
#
# Copy this file to `dev.env` (same folder) and fill in real values.
# dev.env is gitignored -- never commit it. A variable already set in the
# shell wins over this file. SAMPLING_ENV_FILE names a different file.
#
# On Airflow none of this is used: the Teradata login comes from the
# Airflow Connection and the settings from the Airflow Variable.
# ------------------------------------------------------------------------

# -- Teradata (metadata tables and the universe tables) -------------------
TERADATA_HOST=
TERADATA_USER=
TERADATA_PASSWORD=
TERADATA_LOGMECH=LDAP

# -- Settings (the Airflow Variable keys in brackets) ---------------------
# Database holding the GOVT_RGLTRY_SAMPL* tables [meta_db]. Required. May be HSABC_$ENV.
SAMPLING_META_DB=HSABC_DEV
# DEV / QA / INT / UAT / PROD: replaces $env in universe_table / SQL [load_env]
SAMPLING_ENVIRONMENT=DEV
# Replacement text for $env when the environment's default does not fit [env_value]
# SAMPLING_ENV_VALUE=
# Business time zone: as-of date, run ids, timestamps written [timezone]
# SAMPLING_TIMEZONE=America/Chicago
# Rows per fetch / insert batch [chunk_rows]
# SAMPLING_CHUNK_ROWS=1000
# LOCKING ROW FOR ACCESS on reads [access_lock]
# SAMPLING_ACCESS_LOCK=true

# -- Logging ---------------------------------------------------------------
# SAMPLING_LOG_LEVEL=INFO
# SAMPLING_LOG_DIR=logs
