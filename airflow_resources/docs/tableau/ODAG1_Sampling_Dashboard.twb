 datatype="date" name="[As_Of_Dt_Key]" role="dimension" type="ordinal"/><column datatype="integer" name="[In_Scope_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Run_Version]" role="dimension" type="nominal"/><column-instance column="[In_Scope_Cnt]" derivation="Sum" name="[sum:In_Scope_Cnt:qk]" pivot="key" type="quantitative"/><column-instance column="[As_Of_Dt_Key]" derivation="Month-Trunc" name="[tmn:As_Of_Dt_Key:qk]" pivot="key" type="quantitative"/><column-instance column="[Run_Version]" derivation="None" name="[none:Run_Version:nk]" pivot="key" type="nominal"/></datasource-dependencies><filter class="categorical" column="[federated.odag1_sampling].[none:Run_Version:nk]"><groupfilter function="member" level="[none:Run_Version:nk]" member="&quot;Current&quot;"/></filter><slices><column>[federated.odag1_sampling].[none:Run_Version:nk]</column></slices><aggregation value="true"/></view><style/><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Line"/></pane></panes><rows>[federated.odag1_sampling].[sum:In_Scope_Cnt:qk]</rows><cols>[federated.odag1_sampling].[tmn:As_Of_Dt_Key:qk]</cols></table></worksheet><worksheet name="Volume change"><layout-options><title><formatted-text><run fontsize="12" bold="true">Change against the prior month (alert over the threshold)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ODAG1 Sampling" name="federated.odag1_sampling"/><datasource name="Parameters"/></datasources><datasource-dependencies datasource="Parameters"><column caption="Alert threshold (% change)" datatype="real" name="[Parameter 1]" param-domain-type="range" role="measure" type="quantitative" value="0.2"><calculation class="tableau" formula="0.2"/></column><column caption="Standard decision days" datatype="integer" name="[Parameter 2]" param-domain-type="range" role="measure" type="quantitative" value="14"><calculation class="tableau" formula="14"/></column><column caption="Expedited decision days" datatype="integer" name="[Parameter 3]" param-domain-type="range" role="measure" type="quantitative" value="3"><calculation class="tableau" formula="3"/></column><column caption="Delivery deadline hour (Friday, CT)" datatype="integer" name="[Parameter 4]" param-domain-type="range" role="measure" type="quantitative" value="15"><calculation class="tableau" formula="15"/></column><column caption="Weekly target" datatype="integer" name="[Parameter 5]" param-domain-type="range" role="measure" type="quantitative" value="150"><calculation class="tableau" formula="150"/></column></datasource-dependencies><datasource-dependencies datasource="federated.odag1_sampling"><column datatype="date" name="[As_Of_Dt_Key]" role="dimension" type="ordinal"/><column caption="Aberration (Runs)" datatype="string" name="[Calc_RN_Alert]" role="dimension" type="nominal"><calculation class="tableau" formula="IF ABS([Calc_RN_VolChange]) &gt; [Parameters].[Parameter 1] THEN 'Over threshold' ELSE 'Within threshold' END"/></column><column caption="In-scope change vs prior month" datatype="real" name="[Calc_RN_VolChange]" role="measure" type="quantitative"><calculation class="tableau" formula="(SUM([In_Scope_Cnt]) - LOOKUP(SUM([In_Scope_Cnt]), -1)) / LOOKUP(SUM([In_Scope_Cnt]), -1)"/></column><column datatype="integer" name="[In_Scope_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Run_Version]" role="dimension" type="nominal"/><column-instance column="[Calc_RN_VolChange]" derivation="User" name="[usr:Calc_RN_VolChange:qk]" pivot="key" type="quantitative"/><column-instance column="[As_Of_Dt_Key]" derivation="Month-Trunc" name="[tmn:As_Of_Dt_Key:qk]" pivot="key" type="quantitative"/><column-instance column="[Calc_RN_Alert]" derivation="None" name="[none:Calc_RN_Alert:nk]" pivot="key" type="nominal"/><column-instance column="[Run_Version]" derivation="None" name="[none:Run_Version:nk]" pivot="key" type="nominal"/></datasource-dependencies><filter class="categorical" column="[federated.odag1_sampling].[none:Run_Version:nk]"><groupfilter function="member" level="[none:Run_Version:nk]" member="&quot;Current&quot;"/></filter><slices><column>[federated.odag1_sampling].[none:Run_Version:nk]</column></slices><aggregation value="true"/></view><style/><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Bar"/><encodings><color column="[federated.odag1_sampling].[none:Calc_RN_Alert:nk]"/></encodings></pane></panes><rows>[federated.odag1_sampling].[usr:Calc_RN_VolChange:qk]</rows><cols>[federated.odag1_sampling].[tmn:As_Of_Dt_Key:qk]</cols></table></worksheet><worksheet name="Denial rate"><layout-options><title><formatted-text><run fontsize="12" bold="true">Denial rate of the universe per month</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ODAG1 Sampling" name="federated.odag1_sampling"/></datasources><datasource-dependencies datasource="federated.odag1_sampling"><column datatype="date" name="[Batch_Dt]" role="dimension" type="ordinal"/><column caption="Denial rate" datatype="real" name="[Calc_U_DenialRate]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Determination] = 'Denied' THEN 1 ELSE 0 END) / SUM([Case_Cnt])"/></column><column datatype="integer" name="[Case_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Determination]" role="dimension" type="nominal"/><column datatype="string" name="[BTCH_ID]" role="dimension" type="nominal"/><column-instance column="[Calc_U_DenialRate]" derivation="User" name="[usr:Calc_U_DenialRate:qk]" pivot="key" type="quantitative"/><column-instance column="[Batch_Dt]" derivation="Month-Trunc" name="[tmn:Batch_Dt:qk]" pivot="key" type="quantitative"/><column-instance column="[BTCH_ID]" derivation="None" name="[none:BTCH_ID:nk]" pivot="key" type="nominal"/></datasource-de