lumn datatype='string' name='[AUTHZN_REQ_STD_OR_EXPDT_IND]' role='dimension' type='nominal' /><column datatype='string' name='[AUTHZN_REQ_EXPDT_PROCS_STD_IND]' role='dimension' type='nominal' /><column datatype='string' name='[TIMEFRAME_EXT_IND]' role='dimension' type='nominal' /><column datatype='string' name='[PART_B_DRUG_REQ_IND]' role='dimension' type='nominal' /><column datatype='string' name='[REQSTR_TY_CD]' role='dimension' type='nominal' /><column datatype='string' name='[ISS_DESC]' role='dimension' type='nominal' /><column datatype='string' name='[REQ_DENY_FOR_LACK_OF_MED_NECTY_IND]' role='dimension' type='nominal' /><column datatype='string' name='[SVC_CTGRY_CD]' role='dimension' type='nominal' /><column datatype='string' name='[AUTHZN_STAT_RSN_DESC]' role='dimension' type='nominal' /><column datatype='string' name='[WTHDRL_DESC]' role='dimension' type='nominal' /><column datatype='string' name='[REQ_PROV_TY]' role='dimension' type='nominal' /><column datatype='string' name='[SVC_PROV_TY]' role='dimension' type='nominal' /><column datatype='string' name='[CPT_PROC_CD]' role='dimension' type='nominal' /><column datatype='string' name='[RVSN_NBR]' role='dimension' type='nominal' /><column datatype='string' name='[UNVRS_VRSN_CD]' role='dimension' type='nominal' /><column datatype='string' name='[FILE_NM]' role='dimension' type='nominal' /><column datatype='string' name='[SMPL_RUN_ID]' role='dimension' type='nominal' /><column datatype='string' name='[SMPL_RUN_KEY]' role='dimension' type='nominal' /><column datatype='date' name='[SMPL_CYCLE_DT]' role='dimension' type='ordinal' /><column datatype='integer' name='[SMPL_ORDER_NBR]' role='measure' type='quantitative' /><column datatype='string' name='[SMPL_STRATUM_PATH]' role='dimension' type='nominal' /><column datatype='string' name='[Case_Key]' role='dimension' type='nominal' /><column datatype='date' name='[Batch_Dt]' role='dimension' type='ordinal' /><column datatype='string' name='[Request_Type]' role='dimension' type='nominal' /><column datatype='string' name='[Type_Detail]' role='dimension' type='nominal' /><column datatype='string' name='[Functional_Area]' role='dimension' type='nominal' /><column datatype='string' name='[Area_Group]' role='dimension' type='nominal' /><column datatype='string' name='[IP_PAC_Type]' role='dimension' type='nominal' /><column datatype='string' name='[Determination]' role='dimension' type='nominal' /><column datatype='string' name='[Processing]' role='dimension' type='nominal' /><column datatype='string' name='[Network]' role='dimension' type='nominal' /><column datatype='integer' name='[OON_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Med_Necessity_Denial_Ind]' role='measure' type='quantitative' /><column datatype='string' name='[CPT_List]' role='dimension' type='nominal' /><column datatype='string' name='[CPT_First]' role='dimension' type='nominal' /><column datatype='integer' name='[CPT_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Shrpa_Auto_Approved_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Shrpa_No_PA_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Shrpa_Clinical_Review_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Diabetic_Supply_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Initial_Auth_Ind]' role='measure' type='quantitative' /><column datatype='string' name='[Expected_Exclusion]' role='dimension' type='nominal' /><column datatype='string' name='[Needs_Clinical_Auditor]' role='dimension' type='nominal' /><column datatype='string' name='[Auditor_Type]' role='dimension' type='nominal' /><column datatype='date' name='[Request_Dt]' role='dimension' type='ordinal' /><column datatype='date' name='[Determination_Dt]' role='dimension' type='ordinal' /><column datatype='integer' name='[Decision_Days]' role='measure' type='quantitative' /><column datatype='integer' name='[Case_Cnt]' role='measure' type='quantitative' /><column datatype='string' name='[Run_Stat]' role='dimension' type='nominal' /><column datatype='string' name='[Finalized_By]' role='dimension' type='nominal' /><column datatype='datetime' name='[Finalized_Dtts]' role='dimension' type='ordinal' /><column datatype='datetime' name='[Run_End_Dtts]' role='dimension' type='ordinal' /><column datatype='string' name='[Selection_Stat]' role='dimension' type='nominal' /><column datatype='string' name='[Linked_Case_Key]' role='dimension' type='nominal' /><column datatype='string' name='[Stat_Rsn_Txt]' role='dimension' type='nominal' /><column datatype='string' name='[Stat_By]' role='dimension' type='nominal' /><column datatype='integer' name='[Priority_Rank_Nbr]' role='measure' type='quantitative' /><column datatype='integer' name='[Bucket_Rank_Nbr]' role='measure' type='quantitative' /><column datatype='integer' name='[Stratum_Candidate_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Stratum_Selected_Cnt]' role='measure' type='quantitative' /><column datatype='real' name='[Design_Weight]' role='measure' type='quantitative' /><column datatype='real' name='[Sampling_Fraction]' role='measure' type='quantitative' /><column caption="Clinical auditor cases" datatype='real' name='[Calc_SA_Clinical]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Needs_Clinical_Auditor] = 'Yes' THEN 1 ELSE 0 END)" /></column><column caption="Expedited cases" datatype='real' name='[Calc_SA_Expedited]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Processing] = 'Expedited' THEN 1 ELSE 0 END)" /></column><column caption="Selected vs target" datatype='real' name='[Calc_SA_VsTarget]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Case_Cnt]) - [Parameters].[Parameter 5]" /></column><column caption="Out-of-network denials" datatype='real' name='[Calc_SA_OONDenied]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Determination] = 'Denied' AND [OON_Ind] = 1 THEN 1 ELSE 0 END)" /></column></datasource><datasource caption="Runs" inline='true' name='federated.v_smpl_dsh_run' version='18.1'><connection class='federated'><named-connections><named-connection caption='Teradata' name='teradata.rn'><connection authentication='auth-teradata' class='teradata' dbname='HSLABBOSS' odbc-native-protocol='' one-time-sql='' server='TERADATA_SERVER' username='' /></named-connection></named-connections><relation connection='teradata.rn' name='V_SMPL_DSH_RUN' table='[HSLABBOSS].[V_SMPL_DSH_RUN]' type='table' /></connection><aliases enabled='yes' /><column datatype='string' name='[Smpl_Run_ID]' role='dimension' type='nominal' /><column datatype='string' name='[Project_Cd]' role='dimension' type='nominal' /><column datatype='string' name='[Table_Nm]' role='dimension' type='nominal' /><column datatype='string' name='[Run_Ty]' role='dimension' type='nominal' /><column datatype='string' name='[Run_Key]' role='dimension' type='nominal' /><column datatype='date' name='[As_Of_Dt_Key]' role='dimension' type='ordinal' /><column datatype='string' name='[Run_Stat]' role='dimension' type='nominal' /><column datatype='integer' name='[Curr_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Random_Seed_Nbr]' role='measure' type='quantitative' /><column datatype='integer' name='[In_Scope_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Excluded_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Candidate_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Selected_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Shortfall_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Target_Cnt]' role='measure' type='quantitative' /><column datatype='string' name='[Error_Ty]' role='dimension' type='nominal' /><column datatype='string' name='[Error_Txt]' role='dimension' type='nominal' /><column datatype='string' name='[Override_Rsn_Txt]' role='dimension' type='nominal' /><column datatype='string' name='[Rerun_Rsn_Txt]' role='dimension' type='nominal' /><column datatype='date' name='[Rules_As_Of_Dt]' role='dimension' type='ordinal' /><column datatype='string' name='[Finalized_By]' role='dimension' type='nominal' /><column datatype='datetime' name='[Finalized_Dtts]' role='dimension' type='ordinal' /><column datatype='string' name='[Triggered_By]' role='dimension' type='nominal' /><column datatype='datetime' name='[Start_Dtts]' role='dimension' type='ordinal' /><column datatype='datetime' name='[End_Dtts]' role='dimension' type='ordinal' /><column datatype='string' name='[Config_Hash]' role='dimension' type='nominal' /><column datatype='string' name='[Smpl_Method_Cd]' role='dimension' type='nominal' /><column datatype='real' name='[Duration_Min]' role='measure' type='quantitative' /><column datatype='string' name='[Run_Weekday]' role='dimension' type='nominal' /><column datatype='integer' name='[Start_Hour]' role='measure' type='quantitative' /><column datatype='integer' name='[Rerun_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Override_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Finalized_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Failed_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Completed_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Shortfall_Ind]' role='measure' type='quantitative' /><column datatype='string' name='[Prior_Config_Hash]' role='dimension' type='nominal' /><column datatype='string' name='[Run_Version]' role='dimension' type='nominal' /><column datatype='string' name='[Run_Kind]' role='dimension' type='nominal' /><column datatype='integer' name='[Run_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Config_Changed_Ind]' role='measure' type='quantitative' /><column caption="Delivery deadline" datatype='datetime' name='[Calc_RN_Deadline]' role='dimension' type='ordinal'><calculation class='tableau' formula="DATEADD('hour', [Parameters].[Parameter 4], DATETIME(DATEADD('day', 6 - DATEPART('weekday', [As_Of_Dt_Key]), [As_Of_Dt_Key])))" /></column><column caption="Delivery" datatype='string' name='[Calc_RN_OnTime]' role='dimension' type='nominal'><calculation class='tableau' formula="IF [Run_Stat] &lt;&gt; 'COMPLETED' AND [Run_Stat] &lt;&gt; 'FINAL' THEN 'Not delivered' ELSEIF [End_Dtts] &lt;= [Calc_RN_Deadline] THEN 'On time' ELSE 'Late' END" /></column><column caption="In-scope change vs prior month" datatype='real' name='[Calc_RN_VolChange]' role='measure' type='quantitative'><calculation class='tableau' formula="(SUM([In_Scope_Cnt]) - LOOKUP(SUM([In_Scope_Cnt]), -1)) / LOOKUP(SUM([In_Scope_Cnt]), -1)" /></column><column caption="Aberration" datatype='string' name='[Calc_RN_Alert]' role='dimension' type='nominal'><calculation class='tableau' formula="IF ABS([Calc_RN_VolChange]) &gt; [Parameters].[Parameter 1] THEN 'Over threshold' ELSE 'Within threshold' END" /></column></datasource><datasource caption="Run figures" inline='true' name='federated.v_smpl_dsh_run_stat' version='18.1'><connection class='federated'><named-connections><named-connection caption='Teradata' name='teradata.st'><connection authentication='auth-teradata' class='teradata' dbname='HSLABBOSS' odbc-native-protocol='' one-time-sql='' server='TERADATA_SERVER' username='' /></named-connection></named-connections><relation connection='teradata.st' name='V_SMPL_DSH_RUN_STAT' table='[HSLABBOSS].[V_SMPL_DSH_RUN_STAT]' type='table' /></connection><aliases enabled='yes' /><column datatype='string' name='[Smpl_Run_ID]' role='dimension' type='nominal' /><column datatype='string' name='[Project_Cd]' role='dimension' type='nominal' /><column datatype='strin