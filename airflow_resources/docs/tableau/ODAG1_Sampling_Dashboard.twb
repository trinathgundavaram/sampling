><column caption="Alert threshold (% change)" datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.2'><calculation class='tableau' formula='0.2' /></column><column caption="Standard decision days" datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='14'><calculation class='tableau' formula='14' /></column><column caption="Expedited decision days" datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='3'><calculation class='tableau' formula='3' /></column><column caption="Delivery deadline hour (Friday, CT)" datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='15'><calculation class='tableau' formula='15' /></column><column caption="Weekly target" datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='150'><calculation class='tableau' formula='150' /></column></datasource-dependencies><datasource-dependencies datasource='federated.v_smpl_dsh_run'><column datatype='date' name='[As_Of_Dt_Key]' role='dimension' type='ordinal' /><column caption="Delivery deadline" datatype='datetime' name='[Calc_RN_Deadline]' role='dimension' type='ordinal'><calculation class='tableau' formula="DATEADD('hour', [Parameters].[Parameter 4], DATETIME(DATEADD('day', 6 - DATEPART('weekday', [As_Of_Dt_Key]), [As_Of_Dt_Key])))" /></column><column caption="Delivery" datatype='string' name='[Calc_RN_OnTime]' role='dimension' type='nominal'><calculation class='tableau' formula="IF [Run_Stat] &lt;&gt; 'COMPLETED' AND [Run_Stat] &lt;&gt; 'FINAL' THEN 'Not delivered' ELSEIF [End_Dtts] &lt;= [Calc_RN_Deadline] THEN 'On time' ELSE 'Late' END" /></column><column datatype='datetime' name='[End_Dtts]' role='dimension' type='ordinal' /><column datatype='integer' name='[Run_Cnt]' role='measure' type='quantitative' /><column datatype='string' n