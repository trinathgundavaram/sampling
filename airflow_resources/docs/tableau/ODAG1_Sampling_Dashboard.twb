run fontsize="12" bold="true">Expedited</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ODAG1 Sampling" name="federated.odag1_sampling"/></datasources><datasource-dependencies datasource="federated.odag1_sampling"><column caption="Expedited cases" datatype="real" name="[Calc_SA_Expedited]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Smp_Processing] = 'Expedited' THEN 1 ELSE 0 END)"/></column><column datatype="string" name="[Smp_Processing]" role="dimension" type="nominal"/><column datatype="string" name="[SMPL_RUN_KEY]" role="dimension" type="nominal"/><column-instance column="[Calc_SA_Expedited]" derivation="User" name="[usr:Calc_SA_Expedited:qk]" pivot="key" type="quantitative"/><column-instance column="[SMPL_RUN_KEY]" derivation="None" name="[none:SMPL_RUN_KEY:nk]" pivot="key" type="nominal"/></datasource-dependencies><filter class="categorical" column="[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]" filter-group="1"><groupfilter function="level-members" level="[none:SMPL_RUN_KEY:nk]" user:ui-enumeration="all" user:ui-marker="enumerate"/></filter><slices><column>[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]</column></slices><aggregation value="true"/></view><style><style-rule element="cell"><format attr="font-size" value="26"/><format attr="font-weight" value="bold"/></style-rule></style><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Text"/><encodings><text column="[federated.odag1_sampling].[usr:Calc_SA_Expedited:qk]"/></encodings></pane></panes><rows/><cols/></table></worksheet><worksheet name="KPI OON"><layout-options><title><formatted-text><run fontsize="12" bold="true">Out of network</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ODAG1 Sampling" name="federated.odag1_sampling"/></datasources><datasource-dependencies datasource="federated.odag1_sampling"><column datatype="integer" name="[Smp_OON_Ind]" role="measure" type="quantitative"/><column datatype="string" name="[SMPL_RUN_KEY]" role="dimension" type="nominal"/><column-instance column="[Smp_OON_Ind]" derivation="Sum" name="[sum:Smp_OON_Ind:qk]" pivot="key" type="quantitative"/><column-instance column="[SMPL_RUN_KEY]" derivation="None" name="[none:SMPL_RUN_KEY:nk]" pivot="key" type="nominal"/></datasource-dependencies><filter class="categorical" column="[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]" filter-group="1"><groupfilter function="level-members" level="[none:SMPL_RUN_KEY:nk]" user:ui-enumeration="all" user:ui-marker="enumerate"/></filter><slices><column>[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]</column></slices><aggregation value="true"/></view><style><style-rule element="cell"><format attr="font-size" value="26"/><format attr="font-weight" value="bold"/></style-rule></style><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Text"/><encodings><text column="[federated.odag1_sampling].[sum:Smp_OON_Ind:qk]"/></encodings></pane></panes><rows/><cols/></table></worksheet><worksheet name="KPI Vs Target"><layout-options><title><formatted-text><run fontsize="12" bold="true">Selected minus the weekly target</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ODAG1 Sampling" name="federated.odag1_sampling"/><datasource name="Parameters"/></datasources><datasource-dependencies datasource="Parameters"><column caption="Alert threshold (% change)" datatype="real" name="[Parameter 1]" param-domain-type="range" role="measure" type="quantitative" value="0.2"><calculation class="tableau" formula="0.2"/></column><column caption="Standard decision days" datatype="integer" name="[Parameter 2]" param-domain-type="range" role="measure" type="quantitative" value="14"><calculation class="tableau" formula="14"/></column><column caption="Expedited decision days" datatype="integer" name="[Parameter 3]" param-domain-type="range" role="measure" type="quantitative" value="3"><calculation class="tableau" formula="3"/></column><column caption="Delivery deadline hour (Friday, CT)" datatype="integer" name="[Parameter 4]" param-domain-type="range" role="measure" type="quantitative" value="15"><calculation class="tableau" formula="15"/></column><column caption="Weekly target" datatype="integer" name="[Parameter 5]" param-domain-type="range" role="measure" type="quantitative" value="150"><calculation class="tableau" formula="150"/></column></datasource-dependencies><datasource-dependencies datasource="federated.odag1_sampling"><column caption="Selected vs target" datatype="real" name="[Calc_SA_VsTarget]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM([Smp_Case_Cnt]) - [Parameters].[Parameter 5]"/></column><column datatype="integer" name="[Smp_Case_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[SMPL_RUN_KEY]" role="dimension" type="nominal"/><column-instance column="[Calc_SA_VsTarget]" derivation="User" name="[usr:Calc_SA_VsTarget:qk]" pivot="key" type="quantitative"/><column-instance column="[SMPL_RUN_KEY]" derivation="None" name="[none:SMPL_RUN_KEY:nk]" pivot="key" type="nominal"/></datasource-dependencies><filter class="categorical" column="[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]" filter-group="1"><groupfilter function="level-members" level="[none:SMPL_RUN_KEY:nk]" user:ui-enumeration="all" user:ui-marker="enumerate"/></filter><slices><column>[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]</column></slices><aggregation value="true"/></view><style><style-rule element="cell"><format attr="font-size" value="26"/><format attr="font-weight" value="bold"/></style-rule></style><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Text"/><encodings><text column="[federated.odag1_sampling].[usr:Calc_S