[Priority_Rank_Nbr]" role="measure" type="quantitative"/><column datatype="integer" name="[Selected_Ind]" role="measure" type="quantitative"/><column datatype="string" name="[Exclusion_Check]" role="dimension" type="nominal"/><column datatype="string" name="[Engine_Area]" role="dimension" type="nominal"/><column datatype="string" name="[Area_Check]" role="dimension" type="nominal"/><column caption="Candidates" datatype="real" name="[Calc_U_Candidates]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Sample_Status] = 'Selected' OR [Sample_Status] = 'Not selected' OR [Sample_Status] = 'Replaced' THEN 1 ELSE 0 END)"/></column><column caption="Universe share (candidates)" datatype="real" name="[Calc_U_CandShare]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calc_U_Candidates] / TOTAL([Calc_U_Candidates])"/></column><column caption="Sample share" datatype="real" name="[Calc_U_SelShare]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM([Selected_Ind]) / TOTAL(SUM([Selected_Ind]))"/></column><column caption="Denial rate" datatype="real" name="[Calc_U_DenialRate]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Determination] = 'Denied' THEN 1 ELSE 0 END) / SUM([Case_Cnt])"/></column><column caption="Late decision" datatype="string" name="[Calc_U_Late]" role="dimension" type="nominal"><calculation class="tableau" formula="IF [Processing] = 'Expedited' AND [Decision_Days] &gt; [Parameters].[Parameter 3] THEN 'Late' ELSEIF [Processing] = 'Standard' AND [Decision_Days] &gt; [Parameters].[Parameter 2] THEN 'Late' ELSEIF ISNULL([Decision_Days]) THEN 'No dates' ELSE 'On time' END"/></column><column caption="Late decision rate" datatype="real" name="[Calc_U_LateRate]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Calc_U_Late] = 'Late' THEN 1 ELSE 0 END) / SUM([Case_Cnt])"/></column><column caption="Universe change vs prior month" datatype="real" name="[Calc_U_VolChange]" role="measure" type="quantitative"><calculation class="tableau" formula="(SUM([Case_Cnt]) - LOOKUP(SUM([Case_Cnt]), -1)) / LOOKUP(SUM([Case_Cnt]), -1)"/></column><column caption="Aberration (Universe)" datatype="string" name="[Calc_U_Alert]" role="dimension" type="nominal"><calculation class="tableau" formula="IF ABS([Calc_U_VolChange]) &gt; [Parameters].[Parameter 1] THEN 'Over threshold' ELSE 'Within threshold' END"/></column><column datatype="string" name="[Runs_Smpl_Run_ID]" role="dimension" type="nominal" caption="Smpl_Run_ID (Runs)"/><column datatype="string" name="[Project_Cd]" role="dimension" type="nominal"/><column datatype="string" name="[Table_Nm]" role="dimension" type="nominal"/><column datatype="string" name="[Run_Ty]" role="dimension" type="nominal"/><column datatype="string" name="[Run_Key]" role="dimension" type="nominal"/><column datatype="date" name="[As_Of_Dt_Key]" role="dimension" type="ordinal"/><column datatype="string" name="[Run_Stat]" role="dimension" type="nominal"/><column datatype="integer" name="[Curr_Ind]" role="measure" type="quantitative"/><column datatype="integer" name="[Random_Seed_Nbr]" role="measure" type="quantitative"/><column datatype="integer" name="[In_Scope_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Excluded_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Candidate_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Selected_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Shortfall_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Target_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Error_Ty]" role="dimension" type="nominal"/><column datatype="string" name="[Error_Txt]" role="dimension" type="nominal"/><column datatype="string" name="[Override_Rsn_Txt]" role="dimension" type="nominal"/><column datatype="string"