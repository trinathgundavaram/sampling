<workbook original-version='18.1' source-build='2023.3.0 (20233.23.1017.0948)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'><preferences><preference name='ui.encoding.shelf.height' value='24' /></preferences><datasources><datasource hasconnection='false' inline='true' name='Parameters' version='18.1'><aliases enabled='yes' /><column caption="Alert threshold (% change)" datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.2'><calculation class='tableau' formula='0.2' /><range granularity='0.05' max='1' min='0' /></column><column caption="Standard decision days" datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='14'><calculation class='tableau' formula='14' /><range granularity='1' max='60' min='1' /></column><column caption="Expedited decision days" datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='3'><calculation class='tableau' formula='3' /><range granularity='1' max='14' min='1' /></column><column caption="Delivery deadline hour (Friday, CT)" datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='15'><calculation class='tableau' formula='15' /><range granularity='1' max='23' min='0' /></column><column caption="Weekly target" datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='150'><calculation class='tableau' formula='150' /><range granularity='1' max='1000' min='1' /></column></datasource><datasource caption="Universe" inline='true' name='federated.v_smpl_dsh_universe' version='18.1'><connection class='federated'><named-connections><named-connection caption='Teradata' name='teradata.u'><connection authentication='auth-teradata' class='teradata' dbname='HSLABBOSS' odbc-native-protocol='' one-time-sql='' server='TERADATA_SERVER' username='' /></na