tring' name='[REQ_PROV_TY]' role='dimension' type='nominal' /><column datatype='string' name='[SVC_PROV_TY]' role='dimension' type='nominal' /><column datatype='string' name='[CPT_PROC_CD]' role='dimension' type='nominal' /><column datatype='string' name='[RVSN_NBR]' role='dimension' type='nominal' /><column datatype='string' name='[UNVRS_VRSN_CD]' role='dimension' type='nominal' /><column datatype='string' name='[FILE_NM]' role='dimension' type='nominal' /><column datatype='integer' name='[Key_Row_Cnt]' role='measure' type='quantitative' /><column datatype='string' name='[Case_Key]' role='dimension' type='nominal' /><column datatype='date' name='[Batch_Dt]' role='dimension' type='ordinal' /><column datatype='string' name='[Request_Type]' role='dimension' type='nominal' /><column datatype='string' name='[Type_Detail]' role='dimension' type='nominal' /><column datatype='string' name='[Functional_Area]' role='dimension' type='nominal' /><column datatype='string' name='[Area_Group]' role='dimension' type='nominal' /><column datatype='string' name='[IP_PAC_Type]' role='dimension' type='nominal' /><column datatype='string' name='[Determination]' role='dimension' type='nominal' /><column datatype='string' name='[Processing]' role='dimension' type='nominal' /><column datatype='string' name='[Network]' role='dimension' type='nominal' /><column datatype='integer' name='[OON_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Med_Necessity_Denial_Ind]' role='measure' type='quantitative' /><column datatype='string' name='[CPT_List]' role='dimension' type='nominal' /><column datatype='string' name='[CPT_First]' role='dimension' type='nominal' /><column datatype='integer' name='[CPT_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[Shrpa_Auto_Approved_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Shrpa_No_PA_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Shrpa_Clinical_Review_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Diabetic_Supply_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[Initial_Auth_Ind]' role='measure' type='quantitative' /><column datatype='string' name='[Expected_Exclusion]' role='dimension' type='nominal' /><column datatype='string' name='[Needs_Clinical_Auditor]' role='dimension' type='nominal' /><column datatype='string' name='[Auditor_Type]' role='dimension' type='nominal' /><column datatype='date' name='[Request_Dt]' role='dimension' type='ordinal' /><column datatype='date' name='[Determination_Dt]' role='dimension' type='ordinal' /><column datatype='integer' name='[Decision_Days]' role='measure' type='quantitative' /><column datatype='integer' name='[Case_Cnt]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Missing_Determination]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_No_Functional_Area]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Missing_CPT]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Bad_Provider_Type]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Bad_Processing_Ind]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Bad_Request_Date]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Bad_Determination_Date]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Notice_Before_Request]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Denial_Missing_MedNec]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Denial_Missing_Written_Notice]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Duplicate_Key]' role='measure' type='quantitative' /><column datatype='integer' name='[DQ_Issue_Cnt]' role='measure' type='quantitative' /><column datatype='string' name='[Sample_Status]' role='dimension' type='nominal' /><column datatype='string' name='[Smpl_Run_ID]' role='dimension' type='nominal' /><column datatype='string' name='[Exclusion_Rsn_Txt]' role='dimension' type='nominal' /><column datatype='string' name='[Not_Selected_Rsn_Txt]' role='dimension' type='nominal' /><column datatype='string' name='[Stratum_Path_Txt]' role='dimension' type='nominal' /><column datatype='integer' name='[Selection_Order_Nbr]' role='measure' type='quantitative' /><column datatype='integer' name='[Priority_Rank_Nbr]' role='measure' type='quantitative' /><column datatype='integer' name='[Selected_Ind]' role='measure' type='quantitative' /><column datatype='string' name='[Exclusion_Check]' role='dimension' type='nominal' /><column caption="Candidates" datatype='real' name='[Calc_U_Candidates]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Sample_Status] = 'Selected' OR [Sample_Status] = 'Not selected' OR [Sample_Status] = 'Replaced' THEN 1 ELSE 0 END)" /></column><column caption="Universe share (candidates)" datatype='real' name='[Calc_U_CandShare]' role='measure' type='quantitative'><calculation class='tableau' formula="[Calc_U_Candidates] / TOTAL([Calc_U_Candidates])" /></column><column caption="Sample share" datatype='real' name='[Calc_U_SelShare]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Selected_Ind]) / TOTAL(SUM([Selected_Ind]))" /></column><column caption="Denial rate" datatype='real' name='[Calc_U_DenialRate]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Determination] = 'Denied' THEN 1 ELSE 0 END) / SUM([Case_Cnt])" /></column><column caption="Late decision" datatype='string' name='[Calc_U_Late]' role='dimension' type='nominal'><calculation class='tableau' formula="IF [Processing] = 'Expedited' AND [Decision_Days] &gt; [Parameters].[Parameter 3] THEN 'Late' ELSEIF [Processing] = 'Standard' AND [Decision_Days] &gt; [Parameters].[Parameter 2] THEN 'Late' ELSEIF ISNULL([Decision_Days]) THEN 'No dates' ELSE 'On time' END" /></column><column caption="Late decision rate" datatype='real' name='[Calc_U_LateRate]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Calc_U_Late] = 'Late' THEN 1 ELSE 0 END) / SUM([Case_Cnt])" /></column><column caption="Universe change vs prior month" datatype='real' name='[Calc_U_VolChange]' role='measure' type='quantitative'><calculation class='tableau' formula="(SUM([Case_Cnt]) - LOOKUP(SUM([Case_Cnt]), -1)) / LOOKUP(SUM([Case_Cnt]), -1)" /></column><column caption="Aberration" datatype='string' name='[Calc_U_Alert]' role='dimension' type='nominal'><calculation class='tableau' formula="IF ABS([Calc_U_VolChange]) &gt; [Parameters].[Parameter 1] THEN 'Over threshold' ELSE 'Within threshold' END" /></column></datasource><datasource caption="Universe risks and errors" inline='true' name='federated.v_smpl_dsh_dq' version='18.1'><connection class='federated'><named-connections><named-connection caption='Teradata' name='teradata.q'><connection authentication='auth-teradata' class='teradata' dbname='HSLABBOSS' odbc-native-protocol='' one-time-sql='' server='TERADATA_SERVER' username='' /></named-connection></named-connections><relation connection='teradata.q' name='V_SMPL_DSH_DQ' table='[HSLABBOSS].[V_SMPL_DSH_DQ]' type='table' /></connection><aliases enabled='yes' /><column datatype='string' name='[BTCH_ID]' role='dimension' type='nominal' /><column datatype='date' name='[Batch_Dt]' role='dimension' type='ordinal' /><column datatype='string' name='[AUTHZN_ID]' role='dimension' type='nominal' /><column datatype='integer' name='[SRC_DATA_KEY]' role='measure' type='quantitative' /><column datatype='string' name='[Case_Key]' role='dimension' type='nominal' /><column datatype='string' name='[Functional_Area]' role='dimension' type='nominal' /><column datatype='string' name='[Determination]' role='dimension' type='nominal' /><column datatype='string' nam