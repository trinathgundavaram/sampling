UNION ALL
SELECT CAST('Sample (target rows)' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM SMPL_CYCLE_DT) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1_Sample GROUP BY 1, 2
UNION ALL
SELECT CAST('Sample runs' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM As_Of_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRun GROUP BY 1, 2
UNION ALL
SELECT CAST('Selection rows (candidates)' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM Smpl_Cycle_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SampleSelection GROUP BY 1, 2
UNION ALL
SELECT CAST('Run figures' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM As_Of_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRunStat GROUP BY 1, 2
UNION ALL
SELECT CAST('Revalidations' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM As_Of_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRevalidation GROUP BY 1, 2
UNION ALL
SELECT CAST('Refinement rows' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM Window_End_Dt) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRefinement GROUP BY 1, 2
) v</relation></_.fcp.ObjectModelEncapsulateLegacy.true...relation></connection><aliases enabled="yes"/><column datatype="string" name="[BTCH_ID]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_ID]" role="dimension" type="nominal"/><column datatype="integer" name="[SRC_DATA_KEY]" role="measure" type="quantitative"/><column datatype="string" name="[MBR_ID]" role="dimension" type="nominal"/><column datatype="string" name="[CNTRCT_NUM]" role="dimension" type="nominal"/><column datatype="string" name="[PBP_NUM]" role="dimension" type="nominal"/><column datatype="string" name="[FDR_NM]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_REQ_DT]" role="dimension" type="nominal"/><column datatype="string" name="[DETRMTN_NOTFTN_DT]" role="dimension" type="nominal"/><column datatype="string" name="[MBR_WRTN_NOTFTN_DT]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_REQ_DETRMTN_TY]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_REQ_STD_OR_EXPDT_IND]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_REQ_EXPDT_PROCS_STD_IND]" role="dimension" type="nominal"/><column datatype="string" name="[TIMEFRAME_EXT_IND]" role="dimension" type="nominal"/><column datatype="string" name="[PART_B_DRUG_REQ_IND]" role="dimension" type="nominal"/><column datatype="string" name="[REQSTR_TY_CD]" role="dimension" type="nominal"/><column datatype="string" name="[ISS_DESC]" role="dimension" type="nominal"/><column datatype="string" name="[REQ_DENY_FOR_LACK_OF_MED_NECTY_IND]" role="dimension" type="nominal"/><column datatype="string" name="[SVC_CTGRY_CD]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_STAT_RSN_DESC]" role="dimension" type="nominal"/><column datatype="string" name="[AUTHZN_STAT_RSN]" role="dimension" type="nominal"/><column datatype="string" name="[REQ_PROV_TY]" role="dimension" type="nominal"/><column datatype="string" name="[SVC_PROV_T