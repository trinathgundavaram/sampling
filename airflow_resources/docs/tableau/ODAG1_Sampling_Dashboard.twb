quantitative" caption="Rule_ID (Refinement)"/><column datatype="integer" name="[Short_Run_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Refine_Missing_Cnt]" role="measure" type="quantitative" caption="Missing_Cnt (Refinement)"/><column datatype="integer" name="[Blocked_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Lost_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Refine_Case_Cnt]" role="measure" type="quantitative" caption="Case_Cnt (Refinement)"/><column datatype="real" name="[Prior_Avg_Val]" role="measure" type="quantitative"/><column datatype="date" name="[Last_As_Of_Dt]" role="dimension" type="ordinal"/><column datatype="string" name="[Finding_Txt]" role="dimension" type="nominal"/><column datatype="string" name="[Threshold_Txt]" role="dimension" type="nominal"/><column datatype="datetime" name="[Report_Dtts]" role="dimension" type="ordinal"/><column datatype="string" name="[Review_By]" role="dimension" type="nominal"/><column datatype="datetime" name="[Review_Dtts]" role="dimension" type="ordinal"/><column datatype="string" name="[Review_Txt]" role="dimension" type="nominal"/><column datatype="string" name="[Row_Kind]" role="dimension" type="nominal"/><column datatype="string" name="[Review_Status]" role="dimension" type="nominal"/><column datatype="integer" name="[Finding_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Batch_Project_Cd]" role="dimension" type="nominal" caption="Project_Cd (Batches)"/><column datatype="string" name="[Batch_Table_Nm]" role="dimension" type="nominal" caption="Table_Nm (Batches)"/><column datatype="string" name="[Batch_Run_Ty]" role="dimension" type="nominal" caption="Run_Ty (Batches)"/><column datatype="string" name="[Batch_Btch_ID]" role="dimension" type="nominal" caption="Btch_ID (Batches)"/><column datatype="integer" name="[Source_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Closed_Source_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Batch_Status]" role="dimension" type="nominal"/><column datatype="date" name="[Batch_Batch_Dt]" role="dimension" type="ordinal" caption="Batch_Dt (Batches)"/><column datatype="string" name="[Batch_Smpl_Run_ID]" role="dimension" type="nominal" caption="Smpl_Run_ID (Batches)"/><column datatype="string" name="[Batch_Run_Stat]" role="dimension" type="nominal" caption="Run_Stat (Batches)"/><column datatype="datetime" name="[Batch_Start_Dtts]" role="dimension" type="ordinal" caption="Start_Dtts (Batches)"/><column datatype="datetime" name="[Batch_End_Dtts]" role="dimension" type="ordinal" caption="End_Dtts (Batches)"/><column datatype="integer" name="[Batch_Selected_Cnt]" role="measure" type="quantitative" caption="Selected_Cnt (Batches)"/><column datatype="string" name="[Sampled_Status]" role="dimension" type="nominal"/><column datatype="integer" name="[Batch_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[Object_Nm]" role="dimension" type="nominal"/><column datatype="integer" name="[Data_Year]" role="measure" type="quantitative"/><column datatype="integer" name="[Row_Cnt]" role="measure" type="quantitative"/><column datatype="integer" name="[Retention_Link]" role="dimension" type="ordinal"/><_.fcp.ObjectModelEncapsulateLegacy.true...object-graph><objects><object caption="Universe" id="Universe_373C8499D2145883A1A07C28856DEF6D"><properties context=""><relation connection="teradata.odag1" name="Universe" type="text">SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key</relation></properties></object><object caption="Runs" id="Runs_D53E7EF0603551C585E681793C6185AA"><properties context=""><relation connection="teradata.odag1" name="Runs" type="text">SELECT v.Smpl_Run_ID AS Runs_Smpl_Run_ID, v.Project_Cd, v.Table_Nm, v.Run_Ty, v.Run_Key, v.As_Of_Dt_Key, v.Run_Stat, v.Curr_Ind, v.Random_Seed_Nbr, v.In_Scope_Cnt, v.Excluded_Cnt, v.Candidate_Cnt, v.Selected_Cnt, v.Shortfall_Cnt, v.Target_Cnt, v.Error_Ty, v.Error_Txt, v.Override_Rsn_Txt, v.Rerun_Rsn_Txt, v.Rules_As_Of_Dt, v.Finalized_By, v.Finalized_Dtts, v.Triggered_By, v.Start_Dtts, v.End_Dtts, v.Config_Hash, v.Smpl_Method_Cd, v.Duration_Min, v.Run_Weekday, v.Start_Hour, v.Rerun_Ind, v.Override_Ind, v.Finalized_Ind, v.Failed_Ind, v.Completed_Ind, v.Shortfall_Ind, v.Prior_Config_Hash, v.Run_Version, v.Run_Kind, v.Run_Cnt, v.Config_Changed_Ind, CAST(1 AS INTEGER) AS Model_Link
FROM (
SELECT r.Smpl_Run_ID, r.Project_Cd, r.Table_Nm, r.Run_Ty, r.Run_Key, r.As_Of_Dt_Key, r.Run_Stat, r.Curr_Ind, r.Random_Seed_Nbr, r.In_Scope_Cnt, r.Excluded_Cnt, r.Candidate_Cnt, r.Selected_Cnt, r.Shortfall_Cnt, r.Target_Cnt, r.Error_Ty, r.Error_Txt, r.Override_Rsn_Txt, r.Rerun_Rsn_Txt, r.Rules_As_Of_Dt, r.Finalized_By, r.Finalized_Dtts, r.Triggered_By, r.Start_Dtts, r.End_Dtts, r.Config_Hash, r.Smpl_Method_Cd, CAST(((CAST(r.End_Dtts AS DATE) - DATE '2000-01-01') * 86400 + EXTRACT(HOUR FROM r.End_Dtts) * 3600 + EXTRACT(MINUTE FROM r.End_Dtts) * 60 + EXTRACT(SECOND FROM r.End_Dtts) - (CAST(r.Start_Dtts AS DATE) - DATE '2000-01-01') * 86400 + EXTRACT(HOUR FROM r.Start_Dtts) * 3600 + EXTRACT(MINUTE FROM r.Start_Dtts) * 60 + EXTRACT(SECOND FROM r.Start_Dtts)) / 60.0 AS DECIMAL(12,2)) AS Duration_Min, CASE TD_DAY_OF_WEEK(CAST(r.Start_Dtts AS DATE)) WHEN 1 THEN 'Sun' WHEN 2 THEN 'Mon' WHEN 3 THEN 'Tue' WHEN 4 THEN 'Wed' WHEN 5 THEN 'Thu' WHEN 6 THEN 'Fri' ELSE 'Sat' END AS Run_Weekday, EXTRACT(HOUR FROM r.Start_Dtts) AS Start_Hour, CASE WHEN r.Rerun_Rsn_Txt IS NOT NULL THEN 1 ELSE 0 END AS Rerun_Ind, CASE WHEN r.Override_Rsn_Txt IS NOT NULL THEN 1 ELSE 0 END AS Override_Ind, CASE WHEN r.Run_Stat = 'FINAL' THEN 1 ELSE 0 END AS Finalized_Ind, CASE WHEN r.Run_Stat IN ('ERROR', 'FAILED') THEN 1 ELSE 0 END AS Failed_Ind, CASE WHEN r.Run_Stat IN ('COMPLETED', 'FINAL') THEN 1 ELSE 0 END AS Completed_Ind, CASE WHEN SIGN(r.Shortfall_Cnt) = 1 THEN 1 ELSE 0 END AS Shortfall_Ind, MAX(r.Config_Hash) OVER (PARTITION BY r.Project_Cd, r.Table_Nm, r.Run_Ty ORDER BY r.Start_Dtts ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING) AS Prior_Config_Hash, CASE WHEN r.Curr_Ind = 1 THEN 'Current' ELSE 'Replaced by a rerun' END AS Run_Version, CASE WHEN r.Override_Rsn_Txt IS NOT NULL THEN 'Override' WHEN r.Rerun_Rsn_Txt IS NOT NULL THEN 'Rerun' ELSE 'First run' END AS Run_Kind, 1 AS Run_Cnt, CASE WHEN NOT (r.Config_Hash = MAX(r.Config_Hash) OVER (PARTITION BY r.Project_Cd, r.Table_Nm, r.Run_Ty ORDER BY r.Start_Dtts ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING)) THEN 1 ELSE 0 END AS Config_Changed_Ind FROM HSLABBOSS.GOVT_RGLTRY_SamplingRun r
) v</relation></properties></object><object caption="Rules" id="Rules_EF9FA195427558C8B0A7FE5A8821EDC6"><properties context=""><relation connection="teradata.odag1" name="Rules" type="text">SELECT v.Rule_ID, v.Project_Cd AS Rules_Project_Cd, v.Table_Nm AS Rules_Table_Nm, v.Run_Ty AS Rules_Run_Ty, v.Rule_Class_Cd, v.Seq_Nbr, v.Rule_Nm, v.Rule_Ty, v.Level_Nbr, v.Parent_Path_Txt, v.Quota_Cd, v.Quota_Val, v.Max_Ty, v.Max_Val, v.Lookback_Days, v.History_Scope_Cd, v.Rule_Desc, v.Active_Ind, v.Eff_Start_Dt, v.Eff_End_Dt, v.Rule_Sql_Txt, v.In_Effect, v.Rule_Cnt
FROM (
SELECT g.Rule_ID, g.Project_Cd, g.Table_Nm, g.Run_Ty, g.Rule_Class_Cd, g.Seq_Nbr, g.Rule_Nm, g.Rule_Ty, g.Level_Nbr, g.Parent_Path_Txt, g.Quota_Cd, g.Quota_Val, g.Max_Ty, g.Max_Val, g.Lookback_Days, g.History_Scope_Cd, g.Rule_Desc, g.Active_Ind, g.Eff_Start_Dt, g.Eff_End_Dt, g.Rule_Sql_Txt, CASE WHEN g.Active_Ind = 1 AND CURRENT_DATE BETWEEN g.Eff_Start_Dt AND g.Eff_End_Dt THEN 'In effect' ELSE 'Not in effect' END AS In_Effect, 1 AS Rule_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRule g WHERE UPPER(g.Project_Cd) IN ('UMCM', '*')
) v</relation></properties></object><object caption="Sample" id="Sample_49F9521720B55D938735E560D79B3C0C"><properties context=""><relation connection="teradata.odag1" name="Sample" type="text">SELECT v.BTCH_ID AS Smp_BTCH_ID, v.AUTHZN_ID AS Smp_AUTHZN_ID, v.SRC_DATA_KEY AS Smp_SRC_DATA_KEY, v.MBR_ID AS Smp_MBR_ID, v.CNTRCT_NUM AS Smp_CNTRCT_NUM, v.PBP_NUM AS Smp_PBP_NUM, v.FDR_NM AS Smp_FDR_NM, v.AUTHZN_REQ_DT AS Smp_AUTHZN_REQ_DT, v.DETRMTN_NOTFTN_DT AS Smp_DETRMTN_NOTFTN_DT, v.MBR_WRTN_NOTFTN_DT AS Smp_MBR_WRTN_NOTFTN_DT, v.AUTHZN_REQ_DETRMTN_TY AS Smp_AUTHZN_REQ_DETRMTN_TY, v.AUTHZN_REQ_STD_OR_EXPDT_IND AS Smp_AUTHZN_REQ_STD_OR_EXPDT_IND, v.AUTHZN_REQ_EXPDT_PROCS_STD_IND AS Smp_AUTHZN_REQ_EXPDT_PROCS_STD_IND, v.TIMEFRAME_EXT_IND AS Smp_TIMEFRAME_EXT_IND, v.PART_B_DRUG_REQ_IND AS Smp_PART_B_DRUG_REQ_IND, v.REQSTR_TY_CD AS Smp_REQSTR_TY_CD, v.ISS_DESC AS Smp_ISS_DESC, v.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND AS Smp_REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, v.SVC_CTGRY_CD AS Smp_SVC_CTGRY_CD, v.AUTHZN_STAT_RSN_DESC AS Smp_AUTHZN_STAT_RSN_DESC, v.AUTHZN_STAT_RSN AS Smp_AUTHZN_STAT_RSN, v.REQ_PROV_TY AS Smp_REQ_PROV_TY, v.SVC_PROV_TY AS Smp_SVC_PROV_TY, v.CPT_PROC_CD AS Smp_CPT_PROC_CD, v.AUTHZN_REVSN_NUM AS Smp_AUTHZN_REVSN_NUM, v.UNVRS_VRSN_CD AS Smp_UNVRS_VRSN_CD, v.FILE_NM AS Smp_FILE_NM, v.SMPL_RUN_ID AS Smp_SMPL_RUN_ID, v.SMPL_RUN_KEY, v.SMPL_CYCLE_DT, v.SMPL_ORDER_NBR, v.SMPL_STRATUM_PATH, v.Case_Key AS Smp_Case_Key, v.Batch_Dt AS Smp_Batch_Dt, v.Functional_Area AS Smp_Functional_Area, v.Area_Group AS Smp_Area_Group, v.IP_PAC_Type AS Smp_IP_PAC_Type, v.Determination AS Smp_Determination, v.Processing AS Smp_Processing, v.Network AS Smp_Network, v.OON_Ind AS Smp_OON_Ind, v.Med_Necessity_Denial_Ind AS Smp_Med_Necessity_Denial_Ind, v.CPT_List AS Smp_CPT_List, v.CPT_First AS Smp_CPT_First, v.CPT_Cnt AS Smp_CPT_Cnt, v.Initial_Auth_Ind AS Smp_Initial_Auth_Ind, v.Expected_Exclusion AS Smp_Expected_Exclusion, v.Needs_Clinical_Auditor AS Smp_Needs_Clinical_Auditor, v.Auditor_Type AS Smp_Auditor_Type, v.Request_Dt AS Smp_Request_Dt, v.Determination_Dt AS Smp_Determination_Dt, v.Decision_Days AS Smp_Decision_Days, v.Case_Cnt AS Smp_Case_Cnt, v.Request_Type AS Smp_Request_Type, v.Type_Detail AS Smp_Type_Detail, v.Run_Stat AS Smp_Run_Stat, v.Finalized_By AS Smp_Finalized_By, v.Finalized_Dtts AS Smp_Finalized_Dtts, v.Run_End_Dtts, v.Selection_Stat, v.Linked_Case_Key, v.Stat_Rsn_Txt, v.Stat_By, v.Priority_Rank_Nbr AS Smp_Priority_Rank_Nbr, v.Bucket_Rank_Nbr, v.Stratum_Candidate_Cnt, v.Stratum_Selected_Cnt, v.Design_Weight, v.Sampling_Fraction
FROM (
SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.SMPL_RUN_ID, b.SMPL_RUN_KEY, b.SMPL_CYCLE_DT, b.SMPL_ORDER_NBR, b.SMPL_STRATUM_PATH, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail, r.Run_Stat, r.Finalized_By, r.Finalized_Dtts, r.End_Dtts AS Run_End_Dtts, COALESCE(x.Selection_Stat, 'SELECTED') AS Selection_Stat, x.Linked_Case_Key, x.Stat_Rsn_Txt, x.Stat_By, x.Priority_Rank_Nbr, x.Bucket_Rank_Nbr, t.Candidate_Cnt AS Stratum_Candidate_Cnt, t.Selected_Cnt AS Stratum_Selected_Cnt, CASE WHEN SIGN(t.Selected_Cnt) = 1 THEN CAST(t.Candidate_Cnt AS DECIMAL(18,4)) / t.Selected_Cnt END AS Design_Weight, CASE WHEN SIGN(t.Candidate_Cnt) = 1 THEN CAST(t.Selected_Cnt AS DECIMAL(18,4)) / t.Candidate_Cnt END AS Sampling_Fraction FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, o.SMPL_RUN_ID, o.SMPL_RUN_KEY, o.SMPL_CYCLE_DT, o.SMPL_ORDER_NBR, o.SMPL_STRATUM_PATH, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1_Sample o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y') b JOIN HSLABBOSS.GOVT_RGLTRY_SamplingRun r ON r.Smpl_Run_ID = b.SMPL_RUN_ID AND r.Curr_Ind = 1 LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON x.Smpl_Run_ID = b.SMPL_RUN_ID AND x.Case_Key = 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SamplingRunStat t ON t.Smpl_Run_ID = b.SMPL_RUN_ID AND t.Stat_Ty = 'BUCKET' AND t.Stat_Nm = b.SMPL_STRATUM_PATH
) v</relation></properties></object><object caption="Run figures" id="Run_figures_FCD3F4B623615B6281C0FEE24554551F"><properties context=""><relation connection="teradata.odag1" name="Run figures" type="text">SELECT v.Smpl_Run_ID AS Stat_Smpl_Run_ID, v.Project_Cd AS Stat_Project_Cd, v.Table_Nm AS Stat_Table_Nm, v.Run_Ty AS Stat_Run_Ty, v.Run_Key AS Stat_Run_Key, v.As_Of_Dt_Key AS Stat_As_Of_Dt_Key, v.Stat_Ty, v.Stat_Seq_Nbr, v.Stat_Nm, v.Rule_ID AS Stat_Rule_ID, v.Leaf_Ind, v.Candidate_Cnt AS Stat_Candidate_Cnt, v.Target_Cnt AS Stat_Target_Cnt, v.Selected_Cnt AS Stat_Selected_Cnt, v.Limit_Cnt, v.Over_Cnt, v.Replaced_Cnt, v.Case_Cnt AS Stat_Case_Cnt, v.Stat_Txt, v.Run_Curr_Ind, v.Run_Stat AS Stat_Run_Stat, v.Run_Start_Dtts, v.Path_Depth, v.Path_Level_1, v.Path_Level_2, v.Path_Level_3, v.Bucket_Shortfall_Cnt, v.Sampling_Fraction AS Stat_Sampling_Fraction, v.Stat_Kind, v.Leaf_Target_Cnt, v.Leaf_Selected_Cnt, v.Leaf_Candidate_Cnt
FROM (
SELECT t.Smpl_Run_ID, t.Project_Cd, t.Table_Nm, t.Run_Ty, t.Run_Key, t.As_Of_Dt_Key, t.Stat_Ty, t.Stat_Seq_Nbr, t.Stat_Nm, t.Rule_ID, t.Leaf_Ind, t.Candidate_Cnt, t.Target_Cnt, t.Selected_Cnt, t.Limit_Cnt, t.Over_Cnt, t.Replaced_Cnt, t.Case_Cnt, t.Stat_Txt, r.Curr_Ind AS Run_Curr_Ind, r.Run_Stat AS Run_Stat, r.Start_Dtts AS Run_Start_Dtts, CASE WHEN t.Stat_Ty = 'BUCKET' THEN CHARACTER_LENGTH(t.Stat_Nm) - CHARACTER_LENGTH(OREPLACE(t.Stat_Nm, '/', '')) + 1 END AS Path_Depth, CASE WHEN t.Stat_Ty = 'BUCKET' THEN STRTOK(t.Stat_Nm, '/', 1) END AS Path_Level_1, CASE WHEN t.Stat_Ty = 'BUCKET' THEN STRTOK(t.Stat_Nm, '/', 2) END AS Path_Level_2, CASE WHEN t.Stat_Ty = 'BUCKET' THEN STRTOK(t.Stat_Nm, '/', 3) END AS Path_Level_3, CASE WHEN t.Stat_Ty = 'BUCKET' AND SIGN(t.Target_Cnt - t.Selected_Cnt) = 1 THEN t.Target_Cnt - t.Selected_Cnt ELSE 0 END AS Bucket_Shortfall_Cnt, CASE WHEN t.Stat_Ty = 'BUCKET' AND SIGN(t.Candidate_Cnt) = 1 THEN CAST(t.Selected_Cnt AS DECIMAL(18,4)) / t.Candidate_Cnt END AS Sampling_Fraction, CASE WHEN t.Stat_Ty = 'BUCKET' AND t.Leaf_Ind = 1 THEN 'Leaf bucket' WHEN t.Stat_Ty = 'BUCKET' THEN 'Parent bucket' ELSE t.Stat_Ty END AS Stat_Kind, CASE WHEN t.Stat_Ty = 'BUCKET' AND t.Leaf_Ind = 1 THEN t.Target_Cnt ELSE 0 END AS Leaf_Target_Cnt, CASE WHEN t.Stat_Ty = 'BUCKET' AND t.Leaf_Ind = 1 THEN t.Selected_Cnt ELSE 0 END AS Leaf_Selected_Cnt, CASE WHEN t.Stat_Ty = 'BUCKET' AND t.Leaf_Ind = 1 THEN t.Candidate_Cnt ELSE 0 END AS Leaf_Candidate_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRunStat t JOIN HSLABBOSS.GOVT_RGLTRY_SamplingRun r ON r.Smpl_Run_ID = t.Smpl_Run_ID AND r.Curr_Ind = 1
) v</relation></properties></object><object caption="Universe risks and errors" id="Universe_risks_and_errors_9CDEA37E0842581484FCD0C2E8AB6C9A"><properties context=""><relation connection="teradata.odag1" name="Universe risks and errors" type="text">SELECT v.BTCH_ID AS DQ_BTCH_ID, v.Batch_Dt AS DQ_Batch_Dt, v.AUTHZN_ID AS DQ_AUTHZN_ID, v.SRC_DATA_KEY AS DQ_SRC_DATA_KEY, v.Case_Key AS DQ_Case_Key, v.Functional_Area AS DQ_Functional_Area, v.Determination AS DQ_Determination, v.Processing AS DQ_Processing, v.Sample_Status AS DQ_Sample_Status, v.Issue_Txt, v.Severity_Txt, v.Column_Nm, v.Value_Txt, v.Issue_Cnt
FROM (
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Determination missing or not a known value' AS Issue_Txt, 'Error' AS Severity_Txt, 'AUTHZN_REQ_DETRMTN_TY' AS Column_Nm, CAST(u.AUTHZN_REQ_DETRMTN_TY AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Missing_Determination = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Issue description maps to no functional area' AS Issue_Txt, 'Warning' AS Severity_Txt, 'ISS_DESC' AS Column_Nm, CAST(u.ISS_DESC AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_No_Functional_Area = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'No procedure code' AS Issue_Txt, 'Error' AS Severity_Txt, 'CPT_PROC_CD' AS Column_Nm, CAST(u.CPT_PROC_CD AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Missing_CPT = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Servicing provider type is not PAR or Non par' AS Issue_Txt, 'Warning' AS Severity_Txt, 'SVC_PROV_TY' AS Column_Nm, CAST(u.SVC_PROV_TY AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Bad_Provider_Type = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Standard / expedited indicator is not S or E' AS Issue_Txt, 'Error' AS Severity_Txt, 'AUTHZN_REQ_STD_OR_EXPDT_IND' AS Column_Nm, CAST(u.AUTHZN_REQ_STD_OR_EXPDT_IND AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Bad_Processing_Ind = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Request date missing or not a date' AS Issue_Txt, 'Error' AS Severity_Txt, 'AUTHZN_REQ_DT' AS Column_Nm, CAST(u.AUTHZN_REQ_DT AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Bad_Request_Date = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Determination date missing or not a date' AS Issue_Txt, 'Error' AS Severity_Txt, 'DETRMTN_NOTFTN_DT' AS Column_Nm, CAST(u.DETRMTN_NOTFTN_DT AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Bad_Determination_Date = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Determination date before the request date' AS Issue_Txt, 'Error' AS Severity_Txt, 'DETRMTN_NOTFTN_DT' AS Column_Nm, CAST(u.DETRMTN_NOTFTN_DT AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Notice_Before_Request = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Denial without the medical necessity indicator' AS Issue_Txt, 'Warning' AS Severity_Txt, 'REQ_DENY_FOR_LACK_OF_MED_NECTY_IND' AS Column_Nm, CAST(u.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Denial_Missing_MedNec = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'Denial without a member written notification date' AS Issue_Txt, 'Warning' AS Severity_Txt, 'MBR_WRTN_NOTFTN_DT' AS Column_Nm, CAST(u.MBR_WRTN_NOTFTN_DT AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Denial_Missing_Written_Notice = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'The same AUTHZN_ID, SRC_DATA_KEY and AUTHZN_REVSN_NUM more than once in the batch' AS Issue_Txt, 'Error' AS Severity_Txt, 'AUTHZN_ID' AS Column_Nm, CAST(u.AUTHZN_ID AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.DQ_Duplicate_Key = 1
UNION ALL
SELECT u.BTCH_ID, u.Batch_Dt, u.AUTHZN_ID, u.SRC_DATA_KEY, u.Case_Key, u.Functional_Area, u.Determination, u.Processing, u.Sample_Status, 'The engine put the case in another functional area than the dashboard' AS Issue_Txt, 'Error' AS Severity_Txt, 'Stratum_Path_Txt' AS Column_Nm, CAST(u.Engine_Area AS VARCHAR(500)) AS Value_Txt, 1 AS Issue_Cnt FROM (
SELECT d.*, STRTOK(x.Stratum_Path_Txt, '/', 1) AS Engine_Area, CASE WHEN x.Stratum_Path_Txt IS NULL THEN 'Not stratified' WHEN UPPER(STRTOK(x.Stratum_Path_Txt, '/', 1)) = UPPER(d.Functional_Area) THEN 'Agrees' ELSE 'Differs' END AS Area_Check, CASE WHEN d.Determination IN ('Missing', 'Other') THEN 1 ELSE 0 END AS DQ_Missing_Determination, CASE WHEN d.Functional_Area = 'OTHER' THEN 1 ELSE 0 END AS DQ_No_Functional_Area, CASE WHEN d.CPT_List IS NULL THEN 1 ELSE 0 END AS DQ_Missing_CPT, CASE WHEN d.Network = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Provider_Type, CASE WHEN d.Processing = 'Unknown' THEN 1 ELSE 0 END AS DQ_Bad_Processing_Ind, CASE WHEN d.Request_Dt IS NULL THEN 1 ELSE 0 END AS DQ_Bad_Request_Date, CASE WHEN d.Determination_Dt IS NULL AND NOT (d.Determination = 'Missing') THEN 1 ELSE 0 END AS DQ_Bad_Determination_Date, CASE WHEN SIGN(d.Decision_Days) = -1 THEN 1 ELSE 0 END AS DQ_Notice_Before_Request, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_MedNec, CASE WHEN d.Determination = 'Denied' AND COALESCE(TRIM(d.MBR_WRTN_NOTFTN_DT), '') = '' THEN 1 ELSE 0 END AS DQ_Denial_Missing_Written_Notice, CASE WHEN SIGN(d.Key_Row_Cnt - 1) = 1 THEN 1 ELSE 0 END AS DQ_Duplicate_Key, (DQ_Missing_Determination + DQ_No_Functional_Area + DQ_Missing_CPT + DQ_Bad_Provider_Type + DQ_Bad_Processing_Ind + DQ_Bad_Request_Date + DQ_Bad_Determination_Date + DQ_Notice_Before_Request + DQ_Denial_Missing_MedNec + DQ_Denial_Missing_Written_Notice + DQ_Duplicate_Key) AS DQ_Issue_Cnt, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Excluded_Ind = 1 THEN 'Excluded' WHEN x.Selected_Ind = 1 THEN 'Selected' WHEN x.Selection_Stat = 'REPLACED' THEN 'Replaced' WHEN x.Selection_Stat = 'SKIPPED' THEN 'Skipped' ELSE 'Not selected' END AS Sample_Status, x.Smpl_Run_ID, x.Exclusion_Rsn_Txt, x.Not_Selected_Rsn_Txt, x.Stratum_Path_Txt, x.Selection_Order_Nbr, x.Priority_Rank_Nbr, COALESCE(x.Selected_Ind, 0) AS Selected_Ind, CASE WHEN x.Case_Key IS NULL THEN 'Not sampled' WHEN x.Exclusion_Rsn_Txt = 'SELECTED_IN_LAST_90_DAYS' THEN 'Prior selection' WHEN COALESCE(x.Exclusion_Rsn_Txt, '-') = COALESCE(d.Expected_Exclusion, '-') THEN 'Agrees' ELSE 'Differs' END AS Exclusion_Check FROM (SELECT b.BTCH_ID, b.AUTHZN_ID, b.SRC_DATA_KEY, b.MBR_ID, b.CNTRCT_NUM, b.PBP_NUM, b.FDR_NM, b.AUTHZN_REQ_DT, b.DETRMTN_NOTFTN_DT, b.MBR_WRTN_NOTFTN_DT, b.AUTHZN_REQ_DETRMTN_TY, b.AUTHZN_REQ_STD_OR_EXPDT_IND, b.AUTHZN_REQ_EXPDT_PROCS_STD_IND, b.TIMEFRAME_EXT_IND, b.PART_B_DRUG_REQ_IND, b.REQSTR_TY_CD, b.ISS_DESC, b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, b.SVC_CTGRY_CD, b.AUTHZN_STAT_RSN_DESC, b.AUTHZN_STAT_RSN, b.REQ_PROV_TY, b.SVC_PROV_TY, b.CPT_PROC_CD, b.AUTHZN_REVSN_NUM, b.UNVRS_VRSN_CD, b.FILE_NM, b.Key_Row_Cnt, 'AUTHZN_ID=' || COALESCE(TRIM(TRAILING FROM CAST(b.AUTHZN_ID AS VARCHAR(100))), 'NULL') || '|SRC_DATA_KEY=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.SRC_DATA_KEY AS VARCHAR(40)))), 'NULL') || '|AUTHZN_REVSN_NUM=' || COALESCE(TRIM(TRAILING '.' FROM TRIM(CAST(b.AUTHZN_REVSN_NUM AS VARCHAR(40)))), 'NULL') AS Case_Key, TRYCAST(SUBSTR(b.BTCH_ID, 1, 4) || '-' || SUBSTR(b.BTCH_ID, 5, 2) || '-' || SUBSTR(b.BTCH_ID, 7, 2) AS DATE) AS Batch_Dt, CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END AS Functional_Area, CASE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END WHEN 'DME' THEN 'OP PAC' WHEN 'HHC' THEN 'OP PAC' WHEN 'OP Medical' THEN 'Medical' WHEN 'IP Medical' THEN 'Medical' ELSE CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END END AS Area_Group, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_STAT_RSN)) = 'CONCURRENT REVIEW' THEN 'Concurrent Review' WHEN UPPER(b.Request_Type) = 'DRUGS - BIOLOGICS PART B' THEN 'Part B' WHEN UPPER(b.Request_Type) LIKE 'BEHAVIORAL HEALTH%' OR (UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'BEHAVIORAL HEALTH') THEN 'BH' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) LIKE 'DURABLE MEDICAL EQUIPMENT%' THEN 'DME' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' AND UPPER(b.Type_Detail) = 'HOME HEALTH SERVICES' THEN 'HHC' WHEN UPPER(b.Request_Type) = 'INPATIENT' AND (UPPER(b.Type_Detail) IN ('REHAB', 'LTAC') OR UPPER(b.Type_Detail) LIKE 'SNF%') THEN 'IP PAC' WHEN UPPER(b.Request_Type) = 'OUTPATIENT' THEN 'OP Medical' WHEN UPPER(b.Request_Type) = 'INPATIENT' THEN 'IP Medical' ELSE 'OTHER' END = 'IP PAC' THEN CASE WHEN UPPER(b.Type_Detail) = 'REHAB' THEN 'IPRF' WHEN UPPER(b.Type_Detail) = 'LTAC' THEN 'LTAC' ELSE 'SNF' END END AS IP_PAC_Type, CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END AS Determination, CASE UPPER(TRIM(b.AUTHZN_REQ_STD_OR_EXPDT_IND)) WHEN 'E' THEN 'Expedited' WHEN 'S' THEN 'Standard' ELSE 'Unknown' END AS Processing, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 'Out of network' WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'PAR' THEN 'In network' ELSE 'Unknown' END AS Network, CASE WHEN UPPER(TRIM(b.SVC_PROV_TY)) = 'NON PAR' THEN 1 ELSE 0 END AS OON_Ind, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' AND UPPER(TRIM(b.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND)) = 'Y' THEN 1 ELSE 0 END AS Med_Necessity_Denial_Ind, NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), '') AS CPT_List, TRIM(STRTOK(NULLIF(OREPLACE(COALESCE(b.CPT_PROC_CD, ''), ' ', ''), ''), ',', 1)) AS CPT_First, CASE WHEN COALESCE(TRIM(b.CPT_PROC_CD), '') = '' THEN 0 ELSE CHARACTER_LENGTH(OREPLACE(b.CPT_PROC_CD, ' ', '')) - CHARACTER_LENGTH(OREPLACE(OREPLACE(b.CPT_PROC_CD, ' ', ''), ',', '')) + 1 END AS CPT_Cnt, CASE WHEN b.AUTHZN_REVSN_NUM = 1 THEN 1 ELSE 0 END AS Initial_Auth_Ind, CASE WHEN NOT (COALESCE(b.AUTHZN_REVSN_NUM, 0) = 1) THEN 'REVISION' END AS Expected_Exclusion, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Yes' ELSE 'No' END AS Needs_Clinical_Auditor, CASE WHEN CASE WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'APPROVED' THEN 'Approved' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DENIED' THEN 'Denied' WHEN UPPER(TRIM(b.AUTHZN_REQ_DETRMTN_TY)) = 'DISMISSED' THEN 'Dismissed' WHEN COALESCE(TRIM(b.AUTHZN_REQ_DETRMTN_TY), '') = '' THEN 'Missing' ELSE 'Other' END = 'Denied' THEN 'Clinical' ELSE 'Administrative' END AS Auditor_Type, TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Request_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) AS Determination_Dt, TRYCAST(OREPLACE(TRIM(b.DETRMTN_NOTFTN_DT), '/', '-') AS DATE) - TRYCAST(OREPLACE(TRIM(b.AUTHZN_REQ_DT), '/', '-') AS DATE) AS Decision_Days, 1 AS Case_Cnt, b.Request_Type, b.Type_Detail FROM (SELECT o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.MBR_ID, o.CNTRCT_NUM, o.PBP_NUM, o.FDR_NM, o.AUTHZN_REQ_DT, o.DETRMTN_NOTFTN_DT, o.MBR_WRTN_NOTFTN_DT, o.AUTHZN_REQ_DETRMTN_TY, o.AUTHZN_REQ_STD_OR_EXPDT_IND, o.AUTHZN_REQ_EXPDT_PROCS_STD_IND, o.TIMEFRAME_EXT_IND, o.PART_B_DRUG_REQ_IND, o.REQSTR_TY_CD, o.ISS_DESC, o.REQ_DENY_FOR_LACK_OF_MED_NECTY_IND, o.SVC_CTGRY_CD, o.AUTHZN_STAT_RSN_DESC, o.AUTHZN_STAT_RSN, o.REQ_PROV_TY, o.SVC_PROV_TY, o.CPT_PROC_CD, o.AUTHZN_REVSN_NUM, o.UNVRS_VRSN_CD, o.FILE_NM, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 1)) AS Request_Type, TRIM(STRTOK(NULLIF(TRIM(o.ISS_DESC), ''), ',', 2)) AS Type_Detail, COUNT(*) OVER (PARTITION BY o.BTCH_ID, o.AUTHZN_ID, o.SRC_DATA_KEY, o.AUTHZN_REVSN_NUM) AS Key_Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 o WHERE UPPER(TRIM(o.ETL_IS_CURR_IND)) = 'Y' AND UPPER(TRIM(o.ETL_IS_DEL_IND)) = 'N' AND UPPER(TRIM(o.RUN_TY)) = 'WKLY') b) d LEFT JOIN HSLABBOSS.GOVT_RGLTRY_SampleSelection x ON UPPER(x.Project_Cd) = 'UMCM' AND UPPER(x.Table_Nm) = 'ODAG1' AND UPPER(x.Run_Ty) = 'WKLY' AND x.Curr_Ind = 1 AND x.Run_Key = d.BTCH_ID AND x.Case_Key = d.Case_Key
) u WHERE u.Area_Check = 'Differs'
) v</relation></properties></object><object caption="Revalidation" id="Revalidation_0BF7F627AF2B5ACB8A6B41BB3355B74F"><properties context=""><relation connection="teradata.odag1" name="Revalidation" type="text">SELECT v.Reval_ID, v.Smpl_Run_ID AS Reval_Smpl_Run_ID, v.Project_Cd AS Reval_Project_Cd, v.Table_Nm AS Reval_Table_Nm, v.Run_Ty AS Reval_Run_Ty, v.Run_Key AS Reval_Run_Key, v.As_Of_Dt_Key AS Reval_As_Of_Dt_Key, v.Source_As_Of_Dtts, v.Reval_Dtts, v.Triggered_By AS Reval_Triggered_By, v.Reval_Stat, v.Orig_Selected_Cnt, v.Replay_Selected_Cnt, v.Same_Cnt, v.Only_Orig_Cnt, v.Only_Replay_Cnt, v.Missing_Cnt, v.Diff_Txt, v.Engine_Version_Txt, v.Error_Txt AS Reval_Error_Txt, v.Signoff_By, v.Signoff_Dtts, v.Signoff_Txt, v.Signed_Off, v.Match_Ind, v.Days_To_Signoff, v.Reval_Cnt
FROM (
SELECT v.Reval_ID, v.Smpl_Run_ID, v.Project_Cd, v.Table_Nm, v.Run_Ty, v.Run_Key, v.As_Of_Dt_Key, v.Source_As_Of_Dtts, v.Reval_Dtts, v.Triggered_By, v.Reval_Stat, v.Orig_Selected_Cnt, v.Replay_Selected_Cnt, v.Same_Cnt, v.Only_Orig_Cnt, v.Only_Replay_Cnt, v.Missing_Cnt, v.Diff_Txt, v.Engine_Version_Txt, v.Error_Txt, v.Signoff_By, v.Signoff_Dtts, v.Signoff_Txt, CASE WHEN v.Signoff_By IS NULL THEN 'Waiting' ELSE 'Signed off' END AS Signed_Off, CASE WHEN v.Reval_Stat = 'MATCH' THEN 1 ELSE 0 END AS Match_Ind, CAST(v.Signoff_Dtts AS DATE) - CAST(v.Reval_Dtts AS DATE) AS Days_To_Signoff, 1 AS Reval_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRevalidation v
) v</relation></properties></object><object caption="Refinement" id="Refinement_8326D9B10F745F8D9C54E9986ADEB82D"><properties context=""><relation connection="teradata.odag1" name="Refinement" type="text">SELECT v.Refine_ID, v.Finding_Seq_Nbr, v.Project_Cd AS Refine_Project_Cd, v.Table_Nm AS Refine_Table_Nm, v.Run_Ty AS Refine_Run_Ty, v.Window_Start_Dt, v.Window_End_Dt, v.Run_Cnt AS Refine_Run_Cnt, v.Finding_Ty, v.Finding_Nm, v.Rule_ID AS Refine_Rule_ID, v.Short_Run_Cnt, v.Missing_Cnt AS Refine_Missing_Cnt, v.Blocked_Cnt, v.Lost_Cnt, v.Case_Cnt AS Refine_Case_Cnt, v.Prior_Avg_Val, v.Last_As_Of_Dt, v.Finding_Txt, v.Threshold_Txt, v.Report_Dtts, v.Review_By, v.Review_Dtts, v.Review_Txt, v.Row_Kind, v.Review_Status, v.Finding_Cnt
FROM (
SELECT f.Refine_ID, f.Finding_Seq_Nbr, f.Project_Cd, f.Table_Nm, f.Run_Ty, f.Window_Start_Dt, f.Window_End_Dt, f.Run_Cnt, f.Finding_Ty, f.Finding_Nm, f.Rule_ID, f.Short_Run_Cnt, f.Missing_Cnt, f.Blocked_Cnt, f.Lost_Cnt, f.Case_Cnt, f.Prior_Avg_Val, f.Last_As_Of_Dt, f.Finding_Txt, f.Threshold_Txt, f.Report_Dtts, f.Review_By, f.Review_Dtts, f.Review_Txt, CASE WHEN f.Finding_Ty IN ('NOT_PICKED', 'TOPUP', 'REPLACED') THEN 'Total' ELSE 'Finding' END AS Row_Kind, CASE WHEN f.Review_By IS NULL THEN 'Open' ELSE 'Reviewed' END AS Review_Status, 1 AS Finding_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRefinement f
) v</relation></properties></object><object caption="Batches" id="Batches_DE73FB2DE61856DBB16B6BC32E726CF6"><properties context=""><relation connection="teradata.odag1" name="Batches" type="text">SELECT v.Project_Cd AS Batch_Project_Cd, v.Table_Nm AS Batch_Table_Nm, v.Run_Ty AS Batch_Run_Ty, v.Btch_ID AS Batch_Btch_ID, v.Source_Cnt, v.Closed_Source_Cnt, v.Batch_Status, v.Batch_Dt AS Batch_Batch_Dt, v.Smpl_Run_ID AS Batch_Smpl_Run_ID, v.Run_Stat AS Batch_Run_Stat, v.Start_Dtts AS Batch_Start_Dtts, v.End_Dtts AS Batch_End_Dtts, v.Selected_Cnt AS Batch_Selected_Cnt, v.Sampled_Status, v.Batch_Cnt
FROM (
SELECT COALESCE(c.Project_Cd, r.Project_Cd) AS Project_Cd, COALESCE(c.Table_Nm, r.Table_Nm) AS Table_Nm, COALESCE(c.Run_Ty, r.Run_Ty) AS Run_Ty, COALESCE(c.Btch_ID, r.Run_Key) AS Btch_ID, c.Source_Cnt, c.Closed_Source_Cnt, CASE WHEN c.Btch_ID IS NULL THEN 'Not in request control' WHEN c.Closed_Source_Cnt = c.Source_Cnt THEN 'Closed' ELSE 'Open' END AS Batch_Status, TRYCAST(SUBSTR(COALESCE(c.Btch_ID, r.Run_Key), 1, 4) || '-' || SUBSTR(COALESCE(c.Btch_ID, r.Run_Key), 5, 2) || '-' || SUBSTR(COALESCE(c.Btch_ID, r.Run_Key), 7, 2) AS DATE) AS Batch_Dt, r.Smpl_Run_ID, r.Run_Stat, r.Start_Dtts, r.End_Dtts, r.Selected_Cnt, CASE WHEN r.Smpl_Run_ID IS NULL THEN 'Not sampled' ELSE 'Sampled' END AS Sampled_Status, 1 AS Batch_Cnt FROM (SELECT Project_Cd, Table_Nm, Run_Ty, Btch_ID, COUNT(*) AS Source_Cnt, SUM(CASE WHEN Batch_Close_Ind = 1 THEN 1 ELSE 0 END) AS Closed_Source_Cnt FROM HSLABBOSS.GOVT_RGLTRY_RequestControl WHERE UPPER(Project_Cd) = 'UMCM' AND UPPER(Table_Nm) = 'ODAG1' AND UPPER(Run_Ty) = 'WKLY' GROUP BY 1, 2, 3, 4) c FULL OUTER JOIN (SELECT Project_Cd, Table_Nm, Run_Ty, Run_Key, Smpl_Run_ID, Run_Stat, Start_Dtts, End_Dtts, Selected_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRun WHERE UPPER(Project_Cd) = 'UMCM' AND UPPER(Table_Nm) = 'ODAG1' AND UPPER(Run_Ty) = 'WKLY' AND Curr_Ind = 1) r ON r.Run_Key = c.Btch_ID
) v</relation></properties></object><object caption="Retention" id="Retention_7A36D26594905240878CE71C37DC3973"><properties context=""><relation connection="teradata.odag1" name="Retention" type="text">SELECT v.Object_Nm, v.Data_Year, v.Row_Cnt, CAST(1 AS INTEGER) AS Retention_Link
FROM (
SELECT CAST('Universe (source rows, every version)' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM ETL_LOAD_DT_TM) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1 GROUP BY 1, 2
UNION ALL
SELECT CAST('Sample (target rows)' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM SMPL_CYCLE_DT) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.SDO_GOVT_RGLTRY_CLNCL_AUD_UM_AUTHZN_ODAG1_Sample GROUP BY 1, 2
UNION ALL
SELECT CAST('Sample runs' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM As_Of_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRun GROUP BY 1, 2
UNION ALL
SELECT CAST('Selection rows (candidates)' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM Smpl_Cycle_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SampleSelection GROUP BY 1, 2
UNION ALL
SELECT CAST('Run figures' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM As_Of_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRunStat GROUP BY 1, 2
UNION ALL
SELECT CAST('Revalidations' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM As_Of_Dt_Key) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRevalidation GROUP BY 1, 2
UNION ALL
SELECT CAST('Refinement rows' AS VARCHAR(60)) AS Object_Nm, CAST(EXTRACT(YEAR FROM Window_End_Dt) AS INTEGER) AS Data_Year, CAST(COUNT(*) AS BIGINT) AS Row_Cnt FROM HSLABBOSS.GOVT_RGLTRY_SamplingRefinement GROUP BY 1, 2
) v</relation></properties></object></objects><relationships><relationship><expression op="="><expression op="[Case_Key]"/><expression op="[DQ_Case_Key]"/></expression><first-end-point object-id="Universe_373C8499D2145883A1A07C28856DEF6D"/><second-end-point object-id="Universe_risks_and_errors_9CDEA37E0842581484FCD0C2E8AB6C9A"/></relationship><relationship><expression op="="><expression op="[Case_Key]"/><expression op="[Smp_Case_Key]"/></expression><first-end-point object-id="Universe_373C8499D2145883A1A07C28856DEF6D"/><second-end-point object-id="Sample_49F9521720B55D938735E560D79B3C0C"/></relationship><relationship><expression op="="><expression op="[Smpl_Run_ID]"/><expression op="[Runs_Smpl_Run_ID]"/></expression><first-end-point object-id="Universe_373C8499D2145883A1A07C28856DEF6D"/><second-end-point object-id="Runs_D53E7EF0603551C585E681793C6185AA"/></relationship><relationship><expression op="="><expression op="[Runs_Smpl_Run_ID]"/><expression op="[Stat_Smpl_Run_ID]"/></expression><first-end-point object-id="Runs_D53E7EF0603551C585E681793C6185AA"/><second-end-point object-id="Run_figures_FCD3F4B623615B6281C0FEE24554551F"/></relationship><relationship><expression op="="><expression op="[Runs_Smpl_Run_ID]"/><expression op="[Reval_Smpl_Run_ID]"/></expression><first-end-point object-id="Runs_D53E7EF0603551C585E681793C6185AA"/><second-end-point object-id="Revalidation_0BF7F627AF2B5ACB8A6B41BB3355B74F"/></relationship><relationship><expression op="="><expression op="[Runs_Smpl_Run_ID]"/><expression op="[Batch_Smpl_Run_ID]"/></expression><first-end-point object-id="Runs_D53E7EF0603551C585E681793C6185AA"/><second-end-point object-id="Batches_DE73FB2DE61856DBB16B6BC32E726CF6"/></relationship><relationship><expression op="="><expression op="[Stat_Rule_ID]"/><expression op="[Rule_ID]"/></expression><first-end-point object-id="Run_figures_FCD3F4B623615B6281C0FEE24554551F"/><second-end-point object-id="Rules_EF9FA195427558C8B0A7FE5A8821EDC6"/></relationship><relationship><expression op="="><expression op="[Rule_ID]"/><expression op="[Refine_Rule_ID]"/></expression><first-end-point object-id="Rules_EF9FA195427558C8B0A7FE5A8821EDC6"/><second-end-point object-id="Refinement_8326D9B10F745F8D9C54E9986ADEB82D"/></relationship><relationship><expression op="="><expression op="[Model_Link]"/><expression op="[Retention_Link]"/></expression><first-end-point object-id="Runs_D53E7EF0603551C585E681793C6185AA"/><second-end-point object-id="Retention_7A36D26594905240878CE71C37DC3973"/></relationship></relationships></_.fcp.ObjectModelEncapsulateLegacy.true...object-graph></datasource></datasources><worksheets><worksheet name="KPI Selected"><layout-options><title><formatted-text><run fontsize="12" bold="true">Cases selected</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ODAG1 Sampling" name="federated.odag1_sampling"/></datasources><datasource-dependencies datasource="federated.odag1_sampling"><column datatype="integer" name="[Smp_Case_Cnt]" role="measure" type="quantitative"/><column datatype="string" name="[SMPL_RUN_KEY]" role="dimension" type="nominal"/><column-instance column="[Smp_Case_Cnt]" derivation="Sum" name="[sum:Smp_Case_Cnt:qk]" pivot="key" type="quantitative"/><column-instance column="[SMPL_RUN_KEY]" derivation="None" name="[none:SMPL_RUN_KEY:nk]" pivot="key" type="nominal"/></datasource-dependencies><filter class="categorical" column="[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]" filter-group="1"><groupfilter function="level-members" level="[none:SMPL_RUN_KEY:nk]" user:ui-enumeration="all" user:ui-marker="enumerate"/></filter><slices><column>[federated.odag1_sampling].[none:SMPL_RUN_KEY:nk]</column></slices><aggregation value="true"/></view><style><style-rule element="cell"><format attr="font-size" value="26"/><format attr="font-weight" value="bold"/></style-rule></style><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark c