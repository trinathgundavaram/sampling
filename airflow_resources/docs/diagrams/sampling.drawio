rget="f_rq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_str" value="SELECT_FAILURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="714" width="420" height="46" as="geometry" /></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="str" target="f_str"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_out" value="OUTPUT_FAILURE · CONFIG_ERROR (target table columns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="854" width="420" height="46" as="geometry" /></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="out" target="f_out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_per" value="PERSIST_FAILURE: rolled back, nothing half written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="680" y="931" width="420" height="46" as="geometry" /></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="per" target="f_per"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="err" value="Run row ERROR: Error_Ty + one-line Error_Txt&lt;br&gt;(the earlier current sample stays current)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="680" y="1018" width="420" height="60" as="geometry" /></mxCell><mxCell id="dry" value="dry run: everything but the writes (no run row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1018" width="560" height="46" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 Stratify and select"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Stratify and select – each parent's target split between its buckets (runbook 2 step 7–8, 4.2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="s" value="A parent bucket (the sample first) with its target" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="50" as="geometry" /></mxCell><mxCell id="lvl" value="Next LEVEL that applies to this parent&lt;br&gt;(Parent_Path_Txt; most specific bucket set wins)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="60" as="geometry" /></mxCell><mxCell id="has" value="A level left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="240" height="80" as="geometry" /></mxCell><mxCell id="grp" value="Each case into a bucket:&lt;br&gt;by the LEVEL's value, or the first bucket whose SELECT returned it&lt;br&gt;(a bucket without SQL takes the rest; unlisted values: Unlisted_Cd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="360" height="80" as="geometry" /></mxCell><mxCell id="q1" value="CNT buckets, then PCT buckets, in Seq_Nbr order&lt;br&gt;(never above the parent's target; a cut is noted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="360" height="60" as="geometry" /></mxCell><mxCell id="q2" value="SHARE (unlisted values) · ALL buckets water-filled ·&lt;br&gt;REMAINDER takes what is left · SKIP takes none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="360" height="60" as="geometry" /></mxCell><mxCell id="cap" value="Bucket cap Max_Ty / Max_Val&lt;br&gt;(CNT, or PCT of the bucket's candidates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="460" width="300" height="60" as="geometry" /></mxCell><mxCell id="rec" value="Each bucket is a parent:&lt;br&gt;the same again, one level down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="550" width="300" height="60" as="geometry" /></mxCell><mxCell id="leaf" value="Leaf bucket: pick its target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="300" height="80" as="geometry" /></mxCell><mxCell id="m" value="Smpl_Method_Cd" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="240" height="80" as="geometry" /></mxCell><mxCell id="rk" value="RANKED: first in priority order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="300" height="40" as="geometry" /></mxCell><mxCell id="rd" value="RANDOM: shuffled, seeded by (seed, bucket path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="300" height="40" as="geometry" /></mxCell><mxCell id="sy" value="SYSTEMATIC: seeded start, every k-th" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="300" height="40" as="geometry" /></mxCell><mxCell id="dv" value="Diversity_Sql_Txt: rotate across its values,&lt;br&gt;at most Diversity_Cap per value (CNT or PCT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="240" width="300" height="60" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="lvl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lvl" target="has"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="has" target="grp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="has" target="leaf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="q1" target="cap"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="rec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="leaf" target="m"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m" target="rk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m" target="rd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m" target="sy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="leaf" target="dv"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5 Caps and top-up"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="CAP rules and top-up – limits across the whole sample (runbook 2 step 8a–9)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="s" value="The stratified selection, in priority order" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="50" as="geometry" /></mxCell><mxCell id="next" value="Next selected case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="46" as="geometry" /></mxCell><mxCell id="over" value="Over a CAP rule?&lt;br&gt;(QUERY: its cases · PER_VALUE: per value;&lt;br&gt;only under its Parent_Path_Txt)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="300" height="110" as="geometry" /></mxCell><mxCell id="keep" value="Kept: counts toward every cap it is under" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="320" height="50" as="geometry" /></mxCell><mxCell id="cand" value="Next candidate of the same leaf bucket&lt;br&gt;that fits every cap (RANDOM: seeded draw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="360" height="60" as="geometry" /></mxCell><mxCell id="found" value="Found one?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="460" width="240" height="80" as="geometry" /></mxCell><mxCell id="swap" value="Swapped in (caps: over, replaced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="475" width="320" height="50" as="geometry" /></mxCell><mxCell id="shorter" value="Left out: the bucket is one short (noted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="360" height="50" as="geometry" /></mxCell><mxCell id="tu" value="Short of the target and Shortfall_Cd TOPUP?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="670" width="300" height="90" as="geometry" /></mxCell><mxCell id="tuy" value="Top up from the other candidates in priority order&lt;br&gt;(within the caps and the diversity cap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="685" width="320" height="60" as="geometry" /></mxCell><mxCell id="end" value="The sample · shortfall = target − selected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="360" height="50" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="next"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="next" target="over"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="over" target="keep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="over" target="cand"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cand" target="found"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="found" target="swap"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="found" target="shorter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="shorter" target="tu"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tu" target="tuy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tu" target="end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tuy" target="end"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6 After a run"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="After a run – finalise, replace a case, redo a cycle, retention (runbook 10.6–10.9, 12)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="cur" value="Current sample of a cycle&lt;br&gt;(sample + Run_Key, Curr_Ind = 1, COMPLETED)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="60" as="geometry" /></mxCell><mxCell id="fin" value="finalize --run-key K&lt;br&gt;Run_Stat FINAL, Finalized_By / _Dtts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="360" height="60" as="geometry" /></mxCell><mxCell id="rer" value="Rerun of the same Run_Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="320" height="50" as="geometry" /></mxCell><mxCell id="isf" value="Current sample FINAL?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="260" height="80" as="geometry" /></mxCell><mxCell id="frc" value="force_reason given?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="260" width="260" height="80" as="geometry" /></mxCell><mxCell id="ref" value="FINALIZED: refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="275" width="240" height="50" as="geometry" /></mxCell><mxCell id="new" value="New run becomes current&lt;br&gt;the earlier one Curr_Ind = 0&lt;br&gt;(Override_Rsn_Txt kept)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="320" height="60" as="geometry" /></mxCell><mxCell id="rep" value="replace --case-key C --reason R&lt;br&gt;the next candidate of its bucket, never selected before&lt;br&gt;(RANDOM: seeded draw; --any-bucket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="360" height="80" as="geometry" /></mxCell><mxCell id="repd" value="REPLACED / REPLACEMENT with Linked_Case_Key, reason, who;&lt;br&gt;target table rows follow (one transaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="360" height="60" as="geometry" /></mxCell><mxCell id="pur" value="purge --older-than-days D [--apply]&lt;br&gt;(Airflow: retention_days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="360" height="60" as="geometry" /></mxCell><mxCell id="purd" value="Deleted: rows of retired runs, excluded and never-selected rows of&lt;br&gt;current COMPLETED runs. Kept: FINAL runs, selected / REPLACED / REPLACEMENT, run rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="560" height="60" as="geometry" /></mxCell><mxCell id="purs" value="D shorter than the longest history lookback: sample skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="490" width="320" height="60" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;