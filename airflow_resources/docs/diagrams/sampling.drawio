tryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exc" target="ord"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="str" value="7–8. Stratify level by level and select per leaf (page 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="560" height="46" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ord" target="str"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cap" value="8a–9. Caps across the buckets, then top-up (page 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="560" height="46" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="str" target="cap"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="out" value="10. Read the selected cases' source rows back for the target table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="854" width="560" height="46" as="geometry" /></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cap" target="out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="per" value="11. One transaction: selections, target table rows, earlier run of the run_key re