<mxfile host="app.diagrams.net" agent="sampling" version="24.7.17"><diagram id="p1" name="2 DAG run and result"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A DAG run – tasks and how they end (runbook 2, 8)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="s" value="DAG run: scheduled, manual or triggered" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="50" as="geometry" /></mxCell><mxCell id="cfg" value="Variable + runs entry + trigger values&lt;br&gt;(trigger_keys limit what a trigger may change)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="320" height="60" as="geometry" /></mxCell><mxCell id="ok_cfg" value="Variable, Connection and&lt;br&gt;log_level valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="260" height="90" as="geometry" /></mxCell><mxCell id="cfg_bad" value="AirflowFailException: configuration&lt;br&gt;no retry · fail_email · incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="440" y="255" width="300" height="60" as="geometry" /></mxCell><mxCell id="run" value="run_sampling task(s)&lt;br&gt;run_scope: every active sample of the scope, one after another" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="320" height="70" as="geometry" /></mxCell><mxCell id="res" val