ryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="str" target="f_str"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_out" value="OUTPUT_FAILURE · CONFIG_ERROR (target table columns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="854" width="420" height="46" as="geometry" /></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="out" target="f_out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_per" value="PERSIST_FAILURE: rolled back, nothing half written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="680" y="931" width="420" height="46" as="geometry" /></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="per" target="f_per"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="err" value="Run row ERROR: Error_Ty + one-line Error_Txt&lt;br&gt;(the earlier current sample stays current)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="680" y="1018" width="420" height="60" as="geometry" /></mxCell><mxCell id="dry" value="dry run: everything but the writes (no run row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1018" width="560" height="46" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
