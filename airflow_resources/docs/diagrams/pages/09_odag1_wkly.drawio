=0;entryY=0.5;" edge="1" parent="1" source="c74" target="c128"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c130" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="850" y="1940" width="640" height="64" as="geometry" /></mxCell><mxCell id="e131" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c128" target="c130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c132" value="252 Dismissed&lt;br&gt;PCT 12 → 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="1948" width="190" height="48" as="geometry" /></mxCell><mxCell id="c133" value="253 Approved&lt;br&gt;PCT 8 → 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1065" y="1948" width="190" height="48" as="geometry" /></mxCell><mxCell id="c134" value="254 Denied · REMAINDER → 16&lt;br&gt;OON cap 269: at most 10 Non par" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1270" y="1948" width="210" height="48" as="geometry" /></mxCell><mxCell id="c135" value="239 IP Medical&lt;br&gt;REMAINDER → 22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="2016" width="240" height="56" as="geometry" /></mxCell><mxCell id="e136" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c74" target="c135"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c137" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="850" y="2012" width="640" height="64" as="geometry" /></mxCell><mxCell id="e138" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c135" target="c137"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c139" value="252 Dismissed&lt;br&gt;PCT 12 → 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="2020" width="190" height="48" as="geometry" /></mxCell><mxCell id="c140" value="253 Approved&lt;br&gt;PCT 8 → 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1065" y="2020" width="190" height="48" as="geometry" /></mxCell><mxCell id="c141" value="254 Denied · REMAINDER → 17&lt;br&gt;OON cap 270: at most 10 Non par" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1270" y="2020" width="210" height="48" as="geometry" /></mxCell><mxCell id="c142" value="OTHER (no area)&lt;br&gt;SKIP: never picked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="300" y="2088" width="240" height="56" as="geometry" /></mxCell><mxCell id="e143" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c74" target="c142"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c144" value="• Leaves: 6 areas × 3 determinations + 3 IP PAC types × 3 determinations = 27. Their targets add up to 150." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2174" width="1450" height="42" as="geometry" /></mxCell><mxCell id="c145" value="• A case goes to the first level 0 bucket (Seq_Nbr 232 → 239) whose SELECT returned it, then, under IP PAC only, the first of 242 → 244, then 252–254 by the value of 251. Other determination values (Pended, NULL …) become &amp;lt;path&amp;gt;/&amp;lt;value&amp;gt;, SKIP." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2220" width="1450" height="42" as="geometry" /></mxCell><mxCell id="c146" value="• Targets are nominal: every bucket has enough cases. A bucket short of cases gives its slots to its REMAINDER siblings; a bucket with no cases does not appear." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2266" width="1450" height="42" as="geometry" /></mxCell><mxCell id="c147" value="• Caps across the tree: 260 BH at most 8% of the sample · 261 at most 3 cases of one CPT code (every path) · 262–270 at most 10 out-of-network (Non par) cases in each */Denied leaf. A case over a cap is swapped for the next case in its leaf that fits every cap; TOPUP then fills a shortfall from cases that are not SKIP, within the caps." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2312" width="1450" height="42" as="geometry" /></mxCell><mxCell id="c148" value="• SKIP cases are written with Selection_Stat = SKIPPED and are never picked by top-up or replace." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2358" width="1450" height="42" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
