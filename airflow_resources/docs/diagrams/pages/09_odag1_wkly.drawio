"c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="4. 210 history 90 days (PRIOR_SELECTION) · 220 history 14 days (PRIOR_CANDIDATE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="369" width="620" height="50" as="geometry" /></mxCell><mxCell id="c18" value="memory: history[210], history[220] from GOVT_RGLTRY_SampleSelection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="369" width="460" height="50" as="geometry" /></mxCell><mxCell id="e19" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="5. 211 → 212 → 213 → 214 exclusion SELECTs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="439" width="620" height="50" as="geometry" /></mxCell><mxCell id="c22" value="memory: smp_r_211 … smp_r_214 = 1 / 0 per case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="439" width="460" height="50" as="geometry" /></mxCell><mxCell id="e23" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="6. 221 EXPEDITED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="509" width="620" height="50" as="geometry" /></mxCell><mxCell id="c26" value="memory: smp_r_221 = 1 / 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="509" width="460" height="50" as="geometry" /></mxCell><mxCell id="e27" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e28" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="7. 251 determination (Partially Approved → Approved, other values as they are)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="579" width="620" height="50" as="geometry" /></mxCell><mxCell id="c30" value="memory: smp_r_251 = the determination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="579" width="460" height="50" as="geometry" /></mxCell><mxCell id="e31" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e32" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c33" value="8. 232 → 233 → 234 → 235 → 236 → 238 → 239 level 0 bucket SELECTs (231 runs no query)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="649" width="620" height="50" as="geometry" /></mxCell><mxCell id="c34" value="memory: smp_r_232 … smp_r_239 = 1 / 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="649" width="460" height="50" as="geometry" /></mxCell><mxCell id="e35" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e36" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c29" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" value="9. 242 → 243 → 244 level 1 bucket SELECTs, over every case (241 runs no query)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="719" width="620" height="50" as="geometry" /></mxCell><mxCell id="c38" value="memory: smp_r_242 … smp_r_244 = 1 / 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="719" width="460" height="50" as="geometry" /></mxCell><mxCell id="e39" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e40" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c33" target="c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="10. 260 → 261 → 262 … 270 cap SELECTs (262–270 share one SQL: run once, reused 8 times)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="789" width="620" height="50" as="geometry" /></mxCell><mxCell id="c42" value="memory: smp_r_260, smp_r_261 = CPT code, smp_r_262 … smp_r_270" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="789" width="460" height="50" as="geometry" /></mxCell><mxCell id="e43" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e44" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c37" target="c41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c45" value="Use: the stamps are applied, nothing is queried again" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=3;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="370" y="859" width="800" height="26" as="geometry" /></mxCell><mxCell id="c46" value="11. Exclude: 210 first, then 211 → 214; the first hit is the reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="893" width="620" height="50" as="geometry" /></mxCell><mxCell id="c47" value="memory: _reason; the case goes to excluded or candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="893" width="460" height="50" as="geometry" /></mxCell><mxCell id="e48" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e49" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c41" target="c46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c50" value="12. Rank the candidates: 220 carry-over, then 221 expedited, then AUTHZN_ID, SRC_DATA_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="963" width="620" height="50" as="geometry" /></mxCell><mxCell id="c51" value="memory: _order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="963" width="460" height="50" as="geometry" /></mxCell><mxCell id="e52" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e53" style="endArrow=block;html=