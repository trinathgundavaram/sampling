<mxfile host="app.diagrams.net" agent="sampling" version="24.7.17"><diagram id="p4" name="5 Caps and top-up"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="CAP rules and top-up – limits across the whole sample (runbook 2 step 8a–9)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="s" value="The stratified selection, in priority order" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="50" as="geometry" /></mxCell><mxCell id="next" value="Next selected case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="46" as="geometry" /></mxCell><mxCell id="over" value="Over a CAP rule?&lt;br&gt;(QUERY: its cases · PER_VALUE: per value;&lt;br&gt;only under its Parent_Path_Txt)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="300" height="110" as="geometry" /></mxCell><mxCell id="keep" value="Kept: counts toward every cap it is under" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="320" height="50" as="geometry" /></mxCell><mxCell id="cand" value="Next candidate of the same leaf bucket&lt;br&gt;that fits every cap (RANDOM: seeded draw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="360" height="60" as="geometry" /></mxCell><mxCell id="found" value="Found one?" style="rhombus;whiteSpace=